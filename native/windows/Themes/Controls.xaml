<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="DisplayText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <!-- v1.5.7 F5: MetaText(11)=等宽元信息（版本号/状态行/节点详情，需等宽对齐）；SettingsHint(11)=普通说明文字（设置页提示）。语义差异（等宽 vs 非等宽）不合并，分工声明。 -->
  <Style x:Key="MetaText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <!-- v1.5.7 P2: 监视读数数值——等宽 display 档（原 22pt 字面量归档，对齐 macOS 读数口径：等宽+大数字档）。 -->
  <!-- v1.5.7 F5 数值裁决: 22→18 对齐 macOS monitorReadout 值=TypeScale.title=18（等宽 bold；五端读数对齐）。 -->
  <Style x:Key="MonitorReadout" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource MonitorWellTextBrush}" />
  </Style>

  <!-- v1.5.7 P3: 编辑页字号字面量归档——原值入样式、不动渲染（字号数值统一收口归 F5）。 -->
  <Style x:Key="EditorHeaderTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource EditorInkBrush}" />
  </Style>

  <Style x:Key="EditorRailTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource EditorInkBrush}" />
  </Style>

  <Style x:Key="EditorRailLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="Foreground" Value="{DynamicResource EditorLabelBrush}" />
  </Style>

  <Style x:Key="EditorMediaCount" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource EditorInkBrush}" />
  </Style>

  <Style x:Key="EditorMonoLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource EditorLabelBrush}" />
  </Style>

  <Style x:Key="EditorNodeIcon" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style x:Key="EditorCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource EditorLabelBrush}" />
  </Style>

  <Style x:Key="EditorPreviewEmpty" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource GraphiteMutedBrush}" />
  </Style>

  <Style x:Key="EditorAccentLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource EditorAccentBrush}" />
  </Style>

  <Style x:Key="EditorAIMetrics" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource EditorInkBrush}" />
  </Style>

  <Style x:Key="EditorAISummary" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource EditorLabelBrush}" />
  </Style>

  <Style x:Key="EditorScopeHint" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource EditorAccentBrush}" />
  </Style>

  <Style x:Key="AiPreviewEmpty" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource GraphiteMutedBrush}" />
  </Style>

  <Style x:Key="AiPreviewBadge" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource EditorInkBrush}" />
  </Style>

  <Style x:Key="AiPanelHint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <Style x:Key="AiUnlockStatus" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
  </Style>

  <Style x:Key="AiStatusText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <Style x:Key="ButtonBase" TargetType="Button">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10"
                  SnapsToDevicePixels="True">
            <ContentPresenter
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource Paper2Brush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource Paper3Brush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="Opacity" Value="0.5" />
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource Paper3Brush}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="10"
                          Color="{DynamicResource ColorShadow}"
                          Opacity="0.5"
                          ShadowDepth="3" />
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- v1.5.5 fig1: dark capsule for capture bar on #1C1C1E surface. -->
  <Style x:Key="UiCapsuleButton" TargetType="Button">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Foreground" Value="{DynamicResource UiCardInkBrush}" />
    <Setter Property="Background" Value="{DynamicResource UiSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="16"
                  SnapsToDevicePixels="True">
            <ContentPresenter
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource UiCardBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource CapsulePressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="Opacity" Value="0.5" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- v1.5.5 fig1: round shutter, #CDDC39 ring, no shadow. -->
  <Style x:Key="UiShutterButton" TargetType="Button">
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="64" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource UiAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource UiCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="32"
                  SnapsToDevicePixels="True">
            <ContentPresenter
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource ShutterHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource UiSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="Opacity" Value="0.5" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <Style x:Key="MonitorIconButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Width" Value="82" />
    <Setter Property="Height" Value="62" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MonitorWellInkBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,4,0,12" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,4,0,12" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,4,0,8" />
  </Style>

  <Style x:Key="PanelCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="12"
                          Color="{DynamicResource ColorShadow}"
                          Opacity="0.30"
                          ShadowDepth="3" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- fig2 editor workbench: flat dark tool tiles, orange selected state. -->
  <Style x:Key="EditorToolButton" TargetType="Button">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Foreground" Value="{DynamicResource EditorLabelBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource EditorRuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="0"
                  SnapsToDevicePixels="True">
            <ContentPresenter
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource EditorRaisedBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource EditorRaisedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="EditorToolActive" TargetType="Button" BasedOn="{StaticResource EditorToolButton}">
    <Setter Property="Foreground" Value="{DynamicResource EditorAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource EditorRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EditorAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- fig2 editor parameter groups: flat dark expander (no white card). -->
  <Style x:Key="EditorExpander" TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource EditorInkBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ToggleButton x:Name="HeaderSite"
                          Content="{TemplateBinding Header}"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          ClickMode="Press"
                          HorizontalContentAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0"
                          Cursor="Hand">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent" Padding="2,7">
                    <DockPanel>
                      <TextBlock x:Name="Arrow"
                                 DockPanel.Dock="Right"
                                 FontFamily="{DynamicResource MonoFont}"
                                 FontSize="10"
                                 Text="▾"
                                 Foreground="{DynamicResource EditorAccentBrush}" />
                      <ContentPresenter />
                    </DockPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="False">
                      <Setter TargetName="Arrow" Property="Text" Value="▸" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="ExpandSite"
                              Grid.Row="1"
                              Visibility="Collapsed"
                              Margin="4,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- fig2 editor combo boxes: dark flat field (dropdown chrome stays system). -->
  <Style x:Key="EditorComboBox" TargetType="ComboBox">
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,4,0,12" />
    <Setter Property="Background" Value="{DynamicResource EditorRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource EditorInkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EditorRuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- fig2 editor parameter sliders: thin dark track, brand-orange fill, flat thumb. -->
  <Style x:Key="EditorSlider" TargetType="Slider">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Track x:Name="PART_Track" Grid.Row="1">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                              Focusable="False"
                              IsTabStop="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4"
                              CornerRadius="2"
                              Background="{DynamicResource EditorAccentBrush}" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="Thumb"
                       Focusable="False"
                       IsTabStop="False"
                       Width="14"
                       Height="14">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="ThumbBorder"
                              Width="14"
                              Height="14"
                              CornerRadius="3"
                              Background="{DynamicResource EditorAccentBrush}"
                              BorderBrush="{DynamicResource EditorBgBrush}"
                              BorderThickness="1" />
                      <ControlTemplate.Triggers>
                        <!-- Hover/drag lighten variants of #E8833A. -->
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource EditorAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource EditorAccentActiveBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                              Focusable="False"
                              IsTabStop="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4"
                              CornerRadius="2"
                              Background="{DynamicResource EditorRuleBrush}" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- v1.5.7 P4: 设备页字号字面量归档——原值入样式、不动渲染（字号数值统一收口归 F5）。 -->
  <!-- v1.5.7 F5 数值裁决: 24→26 对齐 macOS 页面标题 heading=26（WorkspaceHeading 设备页）。 -->
  <Style x:Key="DeviceHeaderTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style x:Key="DeviceEmptyTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="DeviceBadgeText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
  </Style>

  <Style x:Key="DeviceNameText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <Style x:Key="DeviceMetaText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <!-- v1.5.7 P5: 文件库页字号字面量归档——原值入样式、不动渲染（字号数值统一收口归 F5）。 -->
  <!-- v1.5.7 F5 数值裁决: 24→26 对齐 macOS 页面标题 heading=26（WorkspaceHeading 分支页）。 -->
  <Style x:Key="LibraryHeaderTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style x:Key="LibraryNodeIcon" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
  </Style>

  <!-- v1.5.7 P6: 设置页字号字面量归档——原值入样式、不动渲染（字号数值统一收口归 F5）。 -->
  <Style x:Key="SettingsHint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <Style x:Key="SettingsCardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <Style x:Key="SettingsFeedbackTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

