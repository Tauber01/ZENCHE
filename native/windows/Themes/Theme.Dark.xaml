<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dark appearance overrides (v1.5.6 dual-theme).  Follows the Windows 11
       system app theme.  Colour-stable wells (MonitorWell/Scope/Studio/Editor/
       preview wells) are intentionally absent: they stay graphite in every
       appearance (design.md 229455c graphite-well exception). -->

  <Color x:Key="ColorPaper">#161A21</Color>
  <Color x:Key="ColorPaper2">#1C2129</Color>
  <Color x:Key="ColorPaper3">#232932</Color>
  <Color x:Key="ColorSurface">#1A1F27</Color>
  <Color x:Key="ColorSurfaceRaised">#20262F</Color>
  <Color x:Key="ColorSidebar">#12161C</Color>
  <Color x:Key="ColorRule">#2A313C</Color>
  <Color x:Key="ColorRuleStrong">#3A4350</Color>
  <Color x:Key="ColorNeutral">#8E97A3</Color>
  <Color x:Key="ColorMuted">#9AA3B0</Color>
  <Color x:Key="ColorInk2">#C3CBD6</Color>
  <Color x:Key="ColorInk">#E8EDF3</Color>
  <Color x:Key="ColorFocus">#E0E6EF</Color>
  <Color x:Key="ColorAccentSoft">#14293E</Color>
  <Color x:Key="ColorUiCard">#1C1C1E</Color>
  <Color x:Key="ColorUiSecondary">#2C2C2E</Color>
  <Color x:Key="ColorUiLabel">#8E8E93</Color>
