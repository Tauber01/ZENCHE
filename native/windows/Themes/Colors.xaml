  <!-- Windows dual-theme (v1.5.6): surface tokens shared by both appearances.
       AppBar*/UiCardInk/CapsulePressed/ShutterHover are appearance-paired and
       overridden by Themes/Theme.{Light,Dark}.xaml.  MonitorWell*/EditorInk/
       EditorAccentHover|Active stay colour-stable in every appearance (graphite
       well / fig2 workbench exceptions, design.md 229455c). -->
  <Color x:Key="ColorAppBar">#0A0B0D</Color>
  <Color x:Key="ColorAppBarRule">#414856</Color>
  <Color x:Key="ColorAppBarMuted">#ADB5C1</Color>
  <Color x:Key="ColorAppBarInk">#F0F3F8</Color>
  <Color x:Key="ColorUiCardInk">#F0F3F8</Color>
  <Color x:Key="ColorCapsulePressed">#3A3A3C</Color>
  <Color x:Key="ColorShutterHover">#262628</Color>
  <Color x:Key="ColorMonitorWell">#0A0B0D</Color>
  <Color x:Key="ColorMonitorWell2">#171B24</Color>
  <Color x:Key="ColorMonitorWellRule">#414856</Color>
  <Color x:Key="ColorMonitorWellMuted">#FFFFFF</Color>
  <Color x:Key="ColorMonitorWellInk">#F0F3F8</Color>
  <Color x:Key="ColorMonitorWellCard">#1C1C1E</Color>
  <Color x:Key="ColorMonitorWellSecondary">#2C2C2E</Color>
