<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ZENCHE</AssemblyName>
    <RootNamespace>NikonLink.Windows</RootNamespace>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <Version>1.5.0</Version>
    <Company>ZENCHE contributors</Company>
    <Product>帧澈 ZENCHE</Product>
    <Description>跨平台相机控制与影像传输工具 · Capture · Connect · Flow</Description>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);NIKONLINK_WINDOWS_SHARE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="Services\DataTransferManagerHelper.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\icons\icon-512.png">
      <Link>Assets\icon-512.png</Link>
    </Resource>
    <Resource Include="..\macos\Resources\wechat-donation.png">
      <Link>Assets\wechat-donation.png</Link>
    </Resource>
    <Resource Include="..\macos\Resources\camera-nikon.jpg">
      <Link>Assets\camera-nikon.jpg</Link>
    </Resource>
    <Resource Include="..\macos\Resources\camera-sony.jpg">
      <Link>Assets\camera-sony.jpg</Link>
    </Resource>
    <Resource Include="..\macos\Resources\camera-canon.jpg">
      <Link>Assets\camera-canon.jpg</Link>
    </Resource>
    <Content Include="..\macos\Resources\nikon-cloud-presets.json">
      <Link>Assets\nikon-cloud-presets.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="native\libusb-1.0.dll" Condition="Exists('native\libusb-1.0.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
