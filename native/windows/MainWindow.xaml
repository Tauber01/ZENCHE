                              SelectionChanged="EditorPhotoBox_SelectionChanged" />
                    <Popup x:Name="EditorPhotoPickerPopup"
                           PlacementTarget="{Binding ElementName=EditorPhotoPickerButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                      <Border Width="420"
                              MaxHeight="520"
                              Padding="8"
                              Background="{DynamicResource SurfaceBrush}"
                              BorderBrush="{DynamicResource RuleBrush}"
                              BorderThickness="1"
                              CornerRadius="10">
                        <TreeView x:Name="EditorPhotoTree"
                                  SelectedItemChanged="EditorPhotoTree_SelectedItemChanged">
                          <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                              <Setter Property="IsExpanded"
                                      Value="{Binding IsExpanded, Mode=TwoWay}" />
                              <Setter Property="Padding" Value="4" />
                            </Style>
                          </TreeView.ItemContainerStyle>
                          <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                              <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="64" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="56" Height="42">
                                  <Image x:Name="EditorNodeThumbnail"
                                         Source="{Binding Thumbnail}"
                                         Stretch="UniformToFill" />
                                  <TextBlock x:Name="EditorNodeIcon"
                                             Visibility="Collapsed"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Style="{DynamicResource EditorNodeIcon}"
                                             Text="{Binding Icon}" />
                                </Grid>
                                <StackPanel Grid.Column="1">
                                  <TextBlock FontWeight="SemiBold"
                                             Text="{Binding Name}" />
                                  <TextBlock Margin="0,2,0,0"
                                             Style="{DynamicResource MetaText}"
                                             Text="{Binding Detail}" />
                                </StackPanel>
                              </Grid>
                              <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Thumbnail}"
                                             Value="{x:Null}">
                                  <Setter TargetName="EditorNodeThumbnail"
                                          Property="Visibility"
                                          Value="Collapsed" />
                                  <Setter TargetName="EditorNodeIcon"
                                          Property="Visibility"
                                          Value="Visible" />
                                </DataTrigger>
                              </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                          </TreeView.ItemTemplate>
                        </TreeView>
                      </Border>
                    </Popup>
                  </StackPanel>
                  <TextBlock Grid.Row="3" Style="{DynamicResource EditorCaption}" Text="非破坏编辑 · 保存为高质量副本" TextWrapping="Wrap" />
                </Grid>
              </Border>
              <Border Grid.Column="1"
                      Margin="1,0,1,0"
                      Background="{DynamicResource GraphiteBrush}"
                      BorderBrush="{DynamicResource EditorRuleBrush}"
                      BorderThickness="1"
                      CornerRadius="0">
                <Grid>
                  <Image x:Name="EditorPreviewImage"
                         Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality" />
                  <Canvas x:Name="EditorMaskCanvas"
                          Background="Transparent"
                          MouseLeftButtonDown="EditorMaskCanvas_MouseLeftButtonDown"
                          MouseMove="EditorMaskCanvas_MouseMove"
                          MouseLeftButtonUp="EditorMaskCanvas_MouseLeftButtonUp" />
                  <TextBlock x:Name="EditorPreviewEmpty"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Style="{DynamicResource EditorPreviewEmpty}"
                             Text="选择一张照片开始编辑" />
                </Grid>
              </Border>
              <Border Grid.Column="2"
                      Margin="1,0,0,0"
                      Padding="14"
                      Background="{DynamicResource EditorPanelBrush}"
                      BorderBrush="{DynamicResource EditorRuleBrush}"
                      BorderThickness="1"
                      CornerRadius="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <StackPanel Margin="0,0,0,12">
                      <DockPanel>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="预设" />
                        <ComboBox x:Name="EditorPresetBox"
                                  Width="190"
                                  Margin="10,0,0,0"
                                  Style="{DynamicResource EditorComboBox}"
                                  SelectionChanged="EditorPresetBox_SelectionChanged">
                          <ComboBoxItem Tag="original" Content="原始" />
                          <ComboBoxItem Tag="natural" Content="自然增强" />
                          <ComboBoxItem Tag="portrait" Content="人像柔和" />
                          <ComboBoxItem Tag="landscape" Content="风光通透" />
                          <ComboBoxItem Tag="monochrome" Content="高反差黑白" />
                        </ComboBox>
                      </DockPanel>
                      <DockPanel Margin="0,10,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="尼康云创" />
                        <ComboBox x:Name="NikonCloudPresetBox"
                                  Width="190"
                                  Margin="10,0,0,0"
                                  Style="{DynamicResource EditorComboBox}"
                                  SelectionChanged="NikonCloudPresetBox_SelectionChanged" />
                      </DockPanel>
                      <TextBlock Margin="0,7,0,0"
                                 Style="{DynamicResource EditorCaption}"
                                 TextWrapping="Wrap"
                                 Text="设备端 SDR 近似预览 · 相机与 NX Studio 成片可能不同" />
                    </StackPanel>
                    <Border Padding="12"
                            Background="{DynamicResource EditorRaisedBrush}"
                            BorderBrush="{DynamicResource EditorRuleBrush}"
                            BorderThickness="1"
                            CornerRadius="0">
                      <StackPanel>
                        <DockPanel>
                          <TextBlock FontWeight="SemiBold" Text="AI 智能修图 · 工作台" />
                          <TextBlock DockPanel.Dock="Right"
                                     Style="{DynamicResource EditorAccentLabel}"
                                     Text="设备端" />
                        </DockPanel>
                        <TextBlock x:Name="EditorAIMetricsText"
                                   Margin="0,0,0,8"
                                   Style="{DynamicResource EditorAIMetrics}"
                                   Text="等待分析 · 曝光 --  动态范围 --  色彩 --  细节 --" />
                        <TextBlock x:Name="EditorAISummaryText"
                                   Margin="0,6,0,8"
                                   Style="{DynamicResource EditorAISummary}"
                                   Text="等待分析当前照片"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,0,0,8"
                                   Style="{DynamicResource EditorAccentLabel}"
                                   Text="设备端处理 · 照片不会上传" />
                        <DockPanel>
                          <TextBlock Text="AI 强度" />
                          <TextBlock x:Name="EditorAIIntensityText"
                                     DockPanel.Dock="Right"
                                     Foreground="{DynamicResource EditorLabelBrush}"
                                     FontFamily="{DynamicResource MonoFont}"
                                     Text="72%" />
                        </DockPanel>
                        <Slider x:Name="EditorAIIntensitySlider"
                                Minimum="35"
                                Maximum="100"
                                Value="72"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                Style="{DynamicResource EditorSlider}"
                                ValueChanged="EditorAIIntensity_Changed" />
                        <UniformGrid Margin="0,8,0,0" Columns="3">
                          <Button Style="{DynamicResource EditorToolButton}"
                                  Content="分析画面"
                                  Click="AnalyzeEditorAI_Click" />
                          <Button Style="{DynamicResource PrimaryButton}"
                                  Content="智能优化"
                                  Click="ApplyEditorAI_Click" />
                          <Button x:Name="UndoEditorAIButton"
                                  Margin="8,0,0,0"
                                  Style="{DynamicResource EditorToolButton}"
                                  Content="撤销 AI"
                                  IsEnabled="False"
                                  Click="UndoEditorAI_Click" />
                        </UniformGrid>
                        <UniformGrid Margin="0,8,0,0" Columns="2">
                          <Button x:Name="CopyEditorAIButton"
                                  Style="{DynamicResource EditorToolButton}"
                                  Content="复制 AI"
                                  IsEnabled="False"
                                  Click="CopyEditorAI_Click" />
                          <Button x:Name="PasteEditorAIButton"
                                  Margin="8,0,0,0"
                                  Style="{DynamicResource EditorToolButton}"
                                  Content="粘贴 AI"
                                  IsEnabled="False"
                                  Click="PasteEditorAI_Click" />
                        </UniformGrid>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Grid>

            <!-- 下带两栏：调色面板 / 示波器 -->
            <Grid Grid.Row="1" Margin="0,1,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
              </Grid.ColumnDefinitions>
              <Border x:Name="EditorToolRail"
                      Grid.Column="0"
                      Margin="0,0,1,0"
                      Padding="14"
                      Background="{DynamicResource EditorPanelBrush}"
                      BorderBrush="{DynamicResource EditorRuleBrush}"
                      BorderThickness="1"
                      CornerRadius="0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <UniformGrid Columns="5">
                    <Button x:Name="EditorToolWheels" Margin="2" Tag="wheels" Style="{DynamicResource EditorToolActive}" Click="EditorWorkbenchTool_Click">
                      <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Data="{DynamicResource EditorIconColorWheel}" />
                        <TextBlock Margin="6,0,0,0" Text="色轮" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="EditorToolCurves" Margin="2" Tag="curves" Style="{DynamicResource EditorToolButton}" Click="EditorWorkbenchTool_Click">
                      <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Data="{DynamicResource EditorIconCurve}" />
                        <TextBlock Margin="6,0,0,0" Text="曲线" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="EditorToolMask" Margin="2" Tag="mask" Style="{DynamicResource EditorToolButton}" Click="EditorWorkbenchTool_Click">
                      <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Data="{DynamicResource EditorIconMask}" />
                        <TextBlock Margin="6,0,0,0" Text="蒙版" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="EditorToolGeometry" Margin="2" Tag="geometry" Style="{DynamicResource EditorToolButton}" Click="EditorWorkbenchTool_Click">
                      <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Data="{DynamicResource EditorIconGeometry}" />
                        <TextBlock Margin="6,0,0,0" Text="几何" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="EditorToolAi" Margin="2" Tag="ai" Style="{DynamicResource EditorToolButton}" Click="EditorWorkbenchTool_Click">
                      <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Data="{DynamicResource EditorIconAi}" />
                        <TextBlock Margin="6,0,0,0" Text="AI" />
                      </StackPanel>
                    </Button>
                  </UniformGrid>
                  <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EditorAdjustmentHost" />
                  </ScrollViewer>
                  <TextBlock x:Name="EditorStatusText"
                             Grid.Row="2"
                             Margin="0,10,0,8"
                             Style="{DynamicResource EditorMonoLabel}"
                             Text="调整不会覆盖原文件"
                             TextWrapping="Wrap" />
                  <StackPanel Grid.Row="3"
                              Margin="0,0,0,8"
                              Orientation="Horizontal">
                    <Button x:Name="CompareEditorPhotoButton"
                            Width="132"
                            Style="{DynamicResource EditorToolButton}"
                            Content="查看原图"
                            Click="CompareEditorPhoto_Click" />
                    <Button Width="132"
                            Margin="8,0,0,0"
                            Style="{DynamicResource EditorToolButton}"
                            Content="全部重置"
                            Click="ResetEditor_Click" />
                  </StackPanel>
                  <Button x:Name="SaveEditedPhotoButton"
                          Grid.Row="4"
                          Height="46"
                          Style="{DynamicResource PrimaryButton}"
                          Effect="{x:Null}"
                          Content="保存高质量副本"
                          IsEnabled="False"
                          Click="SaveEditedPhoto_Click" />
                </Grid>
              </Border>
              <Border x:Name="EditorScopeDock"
                      Grid.Column="1"
                      Margin="1,0,0,0"
                      Padding="12"
                      Background="{DynamicResource EditorPanelBrush}"
                      BorderBrush="{DynamicResource EditorRuleBrush}"
                      BorderThickness="1"
                      CornerRadius="0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock Style="{DynamicResource EditorRailTitle}" Text="编辑示波器" />
                  <TextBlock x:Name="EditorScopeText" Grid.Row="1" Margin="0,6,0,0" Style="{DynamicResource EditorScopeHint}" Text="分析后显示实测范围" TextWrapping="Wrap" />
                  <Border Grid.Row="2" Margin="0,12,0,0" Background="{DynamicResource ScopeBlackBrush}" BorderBrush="{DynamicResource EditorRuleBrush}" BorderThickness="1" Padding="3">
                    <local:WaveformScope x:Name="EditorScopeWaveform"
                                         Mode="RgbParade"
                                         MinHeight="72"
                                         AutomationProperties.Name="编辑页 RGB 波形，三通道叠加" />
                  </Border>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <Grid x:Name="EditorAiGrid" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <Border Margin="0,0,18,0"
                    Padding="14"
                    Background="{DynamicResource GraphiteBrush}"
                    BorderBrush="{DynamicResource GraphiteRuleBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
              <Grid>
                <Image x:Name="AiPreviewImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="AiPreviewEmpty"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{DynamicResource AiPreviewEmpty}"
                           Text="选择原图或生成图像后将在这里显示" />
                <StackPanel HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                  <Border Background="{DynamicResource EditorScrimBrush}"
                          CornerRadius="16"
                          Padding="10,6">
                    <TextBlock x:Name="AiPreviewBadge"
                               Style="{DynamicResource AiPreviewBadge}"
                               Text="AI 生成"
                               Visibility="Collapsed" />
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Column="1" Padding="16" Style="{DynamicResource PanelCard}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,8,8">
                <TextBlock FontWeight="SemiBold" Text="编辑照片" />
                <Button x:Name="AiPhotoPickerButton"
                        Margin="0,8,0,10"
                        HorizontalContentAlignment="Left"
                        Padding="10,6"
                        Click="EditorPhotoPickerButton_Click"
                        Content="选择照片" />
                <DockPanel>
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="AI 创作" />
                    <TextBlock Margin="0,3,0,0"
                               Style="{DynamicResource AiPanelHint}"
                               Text="修图覆盖原图 · 生图保存新文件" />
                  </StackPanel>
                  <TextBlock x:Name="AiUnlockStatus"
                             DockPanel.Dock="Right"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center"
                             Style="{DynamicResource AiUnlockStatus}"
                             Text="需要激活" />
                </DockPanel>
                <TextBlock FontWeight="SemiBold" Text="AI 模式" Margin="0,14,0,0" />
                <WrapPanel Margin="0,8,0,10">
                  <Button x:Name="AiEditModeBtn"
                          Width="140"
                          Height="40"
                          Content="AI 修图"
                          Click="AiEditMode_Click" />
                  <Button x:Name="AiGenModeBtn"
                          Width="140"
                          Height="40"
                          Margin="8,0,0,0"
                          Content="AI 生图"
                          Click="AiGenMode_Click" />
                </WrapPanel>
                <TextBlock FontWeight="SemiBold" Text="快捷预设" Margin="0,10,0,0" />
                <WrapPanel x:Name="AiPresetPanel" Margin="0,6,0,10" />
                <TextBlock FontWeight="SemiBold" Text="提示词" />
                <TextBox x:Name="AiPromptBox"
                         Margin="0,8,0,0"
                         Height="80"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
                <TextBlock FontWeight="SemiBold" Text="输出参数" Margin="0,12,0,0" />
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="AiRatioBox"
                            Grid.Column="0"
                            SelectionChanged="AiRatioBox_SelectionChanged">
                    <ComboBoxItem Content="1:1" />
                    <ComboBoxItem Content="16:9" />
                    <ComboBoxItem Content="9:16" />
                    <ComboBoxItem Content="4:3" />
                    <ComboBoxItem Content="3:2" />
                  </ComboBox>
                  <ComboBox x:Name="AiResolutionBox"
                            Grid.Column="2"
                            SelectionChanged="AiResolutionBox_SelectionChanged">
                    <ComboBoxItem Content="1K" />
                    <ComboBoxItem Content="2K" />
                    <ComboBoxItem Content="4K" />
                  </ComboBox>
                </Grid>
                  </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="0,10,0,0"
                        BorderBrush="{DynamicResource RuleBrush}"
                        BorderThickness="0,1,0,0">
                  <StackPanel>
                <Button x:Name="AiGenerateBtn"
                        Margin="0,0,0,8"
                        Height="44"
                        Style="{DynamicResource PrimaryButton}"
                        Content="生成图像"
                        Click="AiGenerate_Click" />
                <TextBlock x:Name="AiStatusText"
                           Style="{DynamicResource AiStatusText}"
                           Text="请输入提示词"
                           TextWrapping="Wrap" />
                <Button x:Name="AiSaveBtn"
                        Margin="0,14,0,0"
                        Height="44"
                        Style="{DynamicResource PrimaryButton}"
                        Content="保存到文件库"
                        Visibility="Collapsed"
                        Click="AiSave_Click" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <Grid x:Name="SettingsPanel" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="680" HorizontalAlignment="Left">
              <TextBlock Style="{DynamicResource DisplayText}" Text="设置" />
              <TextBlock Margin="0,12,0,24"
                         Foreground="{DynamicResource MutedBrush}"
                         Text="通用、拍摄辅助、更新、诊断与支持。" />
              <Border Margin="0,0,0,20" Style="{DynamicResource PanelCard}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{DynamicResource SectionTitle}" Text="语言" />
                    <TextBlock Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Text="语言更改会立即应用，并在下次启动时保留。" />
                  </StackPanel>
                  <ComboBox x:Name="LanguageBox"
                            Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            SelectionChanged="LanguageBox_SelectionChanged">
                    <ComboBoxItem Tag="zh-Hans" Content="简体中文" />
                    <ComboBoxItem Tag="en" Content="English" />
                    <ComboBoxItem Tag="ja" Content="日本語" />
                  </ComboBox>
                </Grid>
              </Border>
              <ContentControl x:Name="CaptureAssistSettingsHost"
                              Margin="0,0,0,20" />
              <Border Style="{DynamicResource PanelCard}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{DynamicResource SectionTitle}" Text="软件更新" />
                    <TextBlock x:Name="CurrentVersionText"
                               Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock x:Name="UpdateStatusText"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="尚未检查更新" />
                  </StackPanel>
                  <WrapPanel Grid.Column="1"
                             Margin="18,0,0,0"
                             VerticalAlignment="Center">
                    <Button x:Name="CheckUpdateButton"
                            Width="112"
                            Margin="0,0,8,0"
                            Style="{DynamicResource ButtonBase}"
                            Content="检查更新"
                            Click="CheckUpdateButton_Click" />
                    <Button x:Name="OpenUpdateButton"
                            Width="132"
                            Style="{DynamicResource PrimaryButton}"
                            Content="获取更新"
                            Visibility="Collapsed"
                            Click="OpenUpdateButton_Click" />
                  </WrapPanel>
                  <Grid Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <PasswordBox x:Name="MirrorChyanCdkBox"
                                   Height="38"
                                   Padding="10,7"
                                   ToolTip="Mirror酱 CDK（可选）" />
                      <TextBlock Margin="0,6,0,0"
                                 Foreground="{DynamicResource MutedBrush}"
                                 Text="CDK 使用 Windows DPAPI 加密保存，不会写入诊断日志。" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="104"
                            Height="38"
                            Margin="10,0,0,0"
                            Style="{DynamicResource ButtonBase}"
                            Content="保存 CDK"
                            Click="SaveMirrorChyanCdkButton_Click" />
                    <Button Grid.Column="2"
                            Width="124"
                            Height="38"
                            Margin="8,0,0,0"
                            Style="{DynamicResource ButtonBase}"
                            Content="打开 Mirror酱"
                            Click="OpenMirrorChyanButton_Click" />
                  </Grid>
                </Grid>
              </Border>
              <Border Margin="0,20,0,0" Style="{DynamicResource PanelCard}">
                <StackPanel>
                  <TextBlock Style="{DynamicResource SectionTitle}" Text="AI 功能激活" />
                  <TextBlock Margin="0,4,0,12"
                             Foreground="{DynamicResource MutedBrush}"
                             TextWrapping="Wrap"
                             Text="AI 修图与生图需购买激活码解锁。每个激活码 100 次，绑定设备，服务器端计数。" />
                  <Button Height="42"
                          Style="{DynamicResource PrimaryButton}"
                          Content="前往官网兑换密钥"
                          Click="AiOfficialWebsite_Click" />
                  <TextBlock Margin="0,8,0,12"
                             Foreground="{DynamicResource MutedBrush}"
                             TextWrapping="Wrap"
                             Text="复制设备 ID 后，前往 zenche.top 使用兑换码兑换绑定当前设备的激活密钥。" />
                  <TextBlock Margin="0,0,0,8"
                             FontWeight="SemiBold"
                             Text="没有兑换码？在爱发电购买兑换码" />
                  <Button Width="300"
                          Height="416"
                          Margin="0,0,0,8"
                          HorizontalAlignment="Center"
                          Padding="4"
                          Style="{DynamicResource ButtonBase}"
                          ToolTip="在爱发电购买兑换码"
                          Click="AiBuy_Click">
                    <Image Source="pack://application:,,,/Assets/wechat-donation.png"
                           Stretch="Uniform" />
                  </Button>
                  <Button Height="38"
                          Margin="0,0,0,6"
                          Style="{DynamicResource ButtonBase}"
                          Content="在爱发电购买兑换码"
                          Click="AiBuy_Click" />
                  <TextBlock Margin="0,0,0,12"
                             Style="{DynamicResource SettingsHint}"
                             TextWrapping="Wrap"
                             Text="兑换码仅用于 AI 云服务次数，帧澈本体保持免费开源。" />
                  <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right"
                            Style="{DynamicResource ButtonBase}"
                            Content="复制"
                            Click="AiCopyDeviceId_Click" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="我的设备 ID" />
                  </DockPanel>
                  <TextBlock x:Name="AiDeviceIdText"
                             Margin="0,0,0,8"
                             Style="{DynamicResource MetaText}"
                             TextWrapping="Wrap" />
                  <TextBlock Margin="0,0,0,12"
                             Foreground="{DynamicResource MutedBrush}"
                             TextWrapping="Wrap"
                             Text="每个激活密钥绑定当前设备，请复制上面的设备 ID 并前往官网兑换。" />
                  <TextBox x:Name="AiActivationCodeBox"
                           Height="38"
                           Padding="10,7"
                           ToolTip="激活码" />
                  <WrapPanel Margin="0,10,0,0">
                    <Button Width="132"
                            Margin="0,0,8,0"
                            Style="{DynamicResource ButtonBase}"
                            Content="购买激活码"
                            Click="AiBuy_Click" />
                    <Button Width="120"
                            Style="{DynamicResource PrimaryButton}"
                            Content="激活"
                            Click="AiActivate_Click" />
                  </WrapPanel>
                  <TextBlock x:Name="AiActivationStatusText"
                             Margin="0,8,0,0"
                             Style="{DynamicResource MetaText}"
                             TextWrapping="Wrap" />
                  <Separator Margin="0,14,0,12" />
                  <TextBlock Margin="0,0,0,8"
                             FontWeight="SemiBold"
                             Text="恢复设备码" />
                  <TextBlock Margin="0,0,0,4"
                             Style="{DynamicResource SettingsHint}"
                             Text="旧设备 ID" />
                  <TextBox x:Name="AiRebindOldDeviceIdBox"
                           Height="38"
                           Margin="0,0,0,8"
                           Padding="10,7"
                           ToolTip="旧设备 ID" />
                  <TextBlock Margin="0,0,0,4"
                             Style="{DynamicResource SettingsHint}"
                             Text="旧激活码" />
                  <PasswordBox x:Name="AiRebindOldCodeBox"
                               Height="38"
                               Margin="0,0,0,8"
                               Padding="10,7"
                               ToolTip="旧激活码" />
                  <TextBlock Margin="0,0,0,8"
                             Style="{DynamicResource SettingsHint}"
                             TextWrapping="Wrap"
                             Text="恢复成功后，AI 权益和剩余次数将迁移到当前设备；旧设备绑定会永久失效。" />
                  <Button x:Name="AiRebindButton"
                          Height="38"
                          Style="{DynamicResource ButtonBase}"
                          Content="恢复到当前设备"
                          Click="AiRebind_Click" />
                </StackPanel>
              </Border>
              <Border Margin="0,20,0,0" Style="{DynamicResource PanelCard}">
                <StackPanel>
                  <TextBlock Style="{DynamicResource SectionTitle}" Text="诊断日志" />
                  <TextBlock x:Name="DiagnosticLogPathText"
                             Margin="0,0,0,16"
                             FontFamily="{DynamicResource MonoFont}"
                             Foreground="{DynamicResource MutedBrush}"
                             TextWrapping="Wrap" />
                  <WrapPanel>
                    <Button Width="112"
                            Margin="0,0,8,0"
                            Style="{DynamicResource ButtonBase}"
                            Content="查询日志"
                            Click="ViewLogs_Click" />
                    <Button Width="132"
                            Margin="0,0,8,0"
                            Style="{DynamicResource ButtonBase}"
                            Content="打开日志目录"
                            Click="OpenLogFolder_Click" />
                    <Button Width="168"
                            Style="{DynamicResource PrimaryButton}"
                            Content="上传脱敏日志"
                            Click="ReportIssue_Click" />
                  </WrapPanel>
                  <TextBlock Margin="0,12,0,0"
                             Foreground="{DynamicResource MutedBrush}"
                             TextWrapping="Wrap"
                             Text="将打开含最近脱敏日志的预填页面；在 GitHub 确认后才会提交。" />
                  <Border Margin="0,14,0,0"
                          Padding="14"
                          Background="{DynamicResource AccentSoftBrush}"
                          BorderBrush="{DynamicResource PhotoSoftBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{DynamicResource SettingsFeedbackTitle}"
                                   Text="快速问题反馈" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{DynamicResource SettingsFeedbackBody}"
                                   Text="公开问题可继续在 GitHub 免费提交；在爱发电赞助后，可获取快速问题反馈渠道。" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              MinWidth="124"
                              Style="{DynamicResource ButtonBase}"
                              Content="打开爱发电"
                              Click="OpenAfdianButton_Click" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <Border Margin="0,20,0,0" Style="{DynamicResource PanelCard}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{DynamicResource SectionTitle}" Text="喜欢 帧澈 ZENCHE？" />
                    <TextBlock Foreground="{DynamicResource MutedBrush}"
                               Text="请作者喝杯奶茶，支持维护和新机型适配。" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Width="160"
                          Margin="18,0,0,0"
                          Style="{DynamicResource PrimaryButton}"
                          Content="请作者喝奶茶"
                          Click="DonationButton_Click" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <Border x:Name="ParameterPanelShell"
              Grid.Column="2"
              Background="{DynamicResource Paper2Brush}"
              BorderBrush="{DynamicResource RuleBrush}"
              BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20">
            <TextBlock x:Name="ParameterPanelTitle"
                       Style="{DynamicResource SectionTitle}"
                       Text="拍摄控制" />
            <TextBlock Margin="0,8,0,4"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MutedBrush}"
                       Text="曝光" />
            <TextBlock x:Name="ExposureModeLabel" Text="拍摄模式" />
            <ComboBox x:Name="ExposureModeBox"
                      SelectionChanged="ExposureModeBox_SelectionChanged">
              <ComboBoxItem Tag="program" Content="P · 程序自动" />
              <ComboBoxItem Tag="shutterPriority" Content="S · 快门优先" />
              <ComboBoxItem Tag="aperturePriority" Content="A · 光圈优先" />
              <ComboBoxItem Tag="manual" Content="M · 手动" IsSelected="True" />
              <ComboBoxItem Tag="bulb" Content="M · B门" />
            </ComboBox>

            <TextBlock x:Name="VideoFrameRateLabel"
                       Text="快门角度换算帧率"
                       Visibility="Collapsed" />
            <ComboBox x:Name="VideoFrameRateBox"
                      Visibility="Collapsed"
                      SelectionChanged="VideoFrameRateBox_SelectionChanged">
              <ComboBoxItem Tag="24" Content="24 fps" />
              <ComboBoxItem Tag="25" Content="25 fps" />
              <ComboBoxItem Tag="30" Content="30 fps" IsSelected="True" />
              <ComboBoxItem Tag="50" Content="50 fps" />
              <ComboBoxItem Tag="60" Content="60 fps" />
            </ComboBox>

            <TextBlock x:Name="ShutterLabel" Text="快门速度" />
            <TextBlock x:Name="VideoShutterModeLabel" Text="视频快门表示" Visibility="Collapsed" />
            <ComboBox x:Name="VideoShutterModeBox"
                      Visibility="Collapsed"
                      SelectionChanged="VideoShutterModeBox_SelectionChanged">
              <ComboBoxItem Tag="speed" Content="快门速度" />
              <ComboBoxItem Tag="angle" Content="快门角度" IsSelected="True" />
            </ComboBox>
            <ComboBox x:Name="ShutterBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="0.000125" Content="1/8000 s" />
              <ComboBoxItem Tag="0.001" Content="1/1000 s" />
              <ComboBoxItem Tag="0.004" Content="1/250 s" />
              <ComboBoxItem Tag="0.008" Content="1/125 s" IsSelected="True" />
              <ComboBoxItem Tag="0.016667" Content="1/60 s" />
              <ComboBoxItem Tag="1" Content="1 s" />
              <ComboBoxItem Tag="30" Content="30 s" />
            </ComboBox>

            <TextBlock x:Name="VideoCodecLabel"
                       Text="视频录制规格"
                       Visibility="Collapsed" />
            <ComboBox x:Name="VideoCodecBox"
                      Visibility="Collapsed"
                      SelectionChanged="VideoCodecBox_SelectionChanged" />
            <TextBlock x:Name="VideoLogLabel"
                       Margin="0,8,0,0"
                       Text="Log / Picture Profile"
                       Visibility="Collapsed" />
            <ComboBox x:Name="VideoLogBox"
                      Margin="0,0,0,10"
                      Visibility="Collapsed"
                      SelectionChanged="VideoLogBox_SelectionChanged" />
            <CheckBox x:Name="ExternalRecordingCheck"
                      Margin="0,8,0,0"
                      Content="外录到当前智能设备"
                      IsChecked="True"
                      Visibility="Collapsed"
                      Click="ExternalRecordingCheck_Click" />
            <TextBlock x:Name="ExternalRecordingHint"
                       Margin="0,4,0,10"
                       Style="{DynamicResource SettingsHint}"
                       TextWrapping="Wrap"
                       Text="实时取景会生成无声 Motion‑JPEG AVI 并写入 ZENCHE 文件库；可与机身录制并行。"
                       Visibility="Collapsed" />

            <TextBlock Text="光圈" />
            <ComboBox x:Name="ApertureBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="1.4" Content="f/1.4" />
              <ComboBoxItem Tag="2.8" Content="f/2.8" />
              <ComboBoxItem Tag="4" Content="f/4" IsSelected="True" />
              <ComboBoxItem Tag="5.6" Content="f/5.6" />
              <ComboBoxItem Tag="8" Content="f/8" />
              <ComboBoxItem Tag="11" Content="f/11" />
              <ComboBoxItem Tag="16" Content="f/16" />
            </ComboBox>

            <TextBlock Text="ISO 感光度" />
            <ComboBox x:Name="IsoBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="64" Content="ISO 64" />
              <ComboBoxItem Tag="100" Content="ISO 100" />
              <ComboBoxItem Tag="200" Content="ISO 200" />
              <ComboBoxItem Tag="400" Content="ISO 400" IsSelected="True" />
              <ComboBoxItem Tag="800" Content="ISO 800" />
              <ComboBoxItem Tag="1600" Content="ISO 1600" />
              <ComboBoxItem Tag="3200" Content="ISO 3200" />
              <ComboBoxItem Tag="6400" Content="ISO 6400" />
              <ComboBoxItem Tag="12800" Content="ISO 12800" />
              <ComboBoxItem Tag="25600" Content="ISO 25600" />
              <ComboBoxItem Tag="51200" Content="ISO 51200" />
              <ComboBoxItem Tag="64000" Content="ISO 64000" />
              <ComboBoxItem Tag="102400" Content="ISO 102400" />
            </ComboBox>

            <TextBlock Text="曝光补偿" />
            <ComboBox x:Name="ExposureCompensationBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="-2" Content="-2 EV" />
              <ComboBoxItem Tag="-1" Content="-1 EV" />
              <ComboBoxItem Tag="0" Content="0 EV" IsSelected="True" />
              <ComboBoxItem Tag="1" Content="+1 EV" />
              <ComboBoxItem Tag="2" Content="+2 EV" />
            </ComboBox>

            <Separator Margin="0,12,0,8" />
            <TextBlock Margin="0,0,0,4"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MutedBrush}"
                       Text="对焦与色彩" />
            <TextBlock Text="对焦模式" />
            <ComboBox x:Name="FocusModeBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="single-shot" Content="AF-S · 单次自动对焦" IsSelected="True" />
              <ComboBoxItem Tag="continuous" Content="AF-C · 连续自动对焦" />
              <ComboBoxItem Tag="manual" Content="MF · 手动对焦" />
            </ComboBox>

            <TextBlock Text="白平衡" />
            <ComboBox x:Name="WhiteBalanceBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="continuous" Content="自动" IsSelected="True" />
              <ComboBoxItem Tag="manual" Content="预设手动" />
            </ComboBox>

            <TextBlock Text="优化校准" />
            <ComboBox x:Name="PictureControlBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="auto" Content="自动" />
              <ComboBoxItem Tag="standard" Content="标准" IsSelected="True" />
              <ComboBoxItem Tag="neutral" Content="自然" />
              <ComboBoxItem Tag="vivid" Content="鲜艳" />
              <ComboBoxItem Tag="monochrome" Content="单色" />
              <ComboBoxItem Tag="portrait" Content="人像" />
              <ComboBoxItem Tag="landscape" Content="风景" />
              <ComboBoxItem Tag="flat" Content="平面" />
            </ComboBox>

            <Expander x:Name="ProfessionalMonitorPanel"
                      Margin="0,16,0,0"
                      Header="专业监看"
                      Visibility="Collapsed"
                      IsExpanded="True">
              <StackPanel Margin="0,8,0,0">
                <CheckBox x:Name="FocusPeakingCheck"
                          Content="峰值对焦"
                          Click="FocusPeakingCheck_Click" />
                <CheckBox x:Name="FalseColorCheck"
                          Margin="0,6,0,0"
                          Content="假色曝光"
                          Click="FalseColorCheck_Click" />
                <Border Margin="0,10,0,0"
                        Padding="4"
                        Background="{DynamicResource ScopeBlackBrush}">
                  <StackPanel>
                    <local:WaveformScope x:Name="ProfessionalScope"
                                         Mode="RgbParade"
                                         Height="210"
                                         AutomationProperties.Name="专业波形图，RGB 三通道叠加" />
                    <TextBlock x:Name="PeakingCoverageText"
                               Margin="0,6,0,0"
                               Style="{DynamicResource ProfMonitorValue}"
                               Text="峰值覆盖 0%" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource AppBarBrush}"
            BorderBrush="{DynamicResource AppBarRuleBrush}"
            BorderThickness="0,1,0,0">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="OperationStatusText"
                   Grid.Column="0"
                   Margin="0,0,14,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource AppBarInkBrush}"
                   FontFamily="{DynamicResource MonoFont}"
                   Style="{DynamicResource CaptureSessionHint}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   Text="就绪" />
        <TextBlock x:Name="PhotoCountText"
                   Grid.Column="1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource AppBarMutedBrush}"
                   FontFamily="{DynamicResource MonoFont}"
                   Style="{DynamicResource CaptureSessionHint}"
                   Text="0 张照片" />
      </Grid>
    </Border>
  </Grid>
</Window>
