                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="64" Content="ISO 64" />
              <ComboBoxItem Tag="100" Content="ISO 100" />
              <ComboBoxItem Tag="200" Content="ISO 200" />
              <ComboBoxItem Tag="400" Content="ISO 400" IsSelected="True" />
              <ComboBoxItem Tag="800" Content="ISO 800" />
              <ComboBoxItem Tag="1600" Content="ISO 1600" />
              <ComboBoxItem Tag="3200" Content="ISO 3200" />
              <ComboBoxItem Tag="6400" Content="ISO 6400" />
              <ComboBoxItem Tag="12800" Content="ISO 12800" />
              <ComboBoxItem Tag="25600" Content="ISO 25600" />
              <ComboBoxItem Tag="51200" Content="ISO 51200" />
              <ComboBoxItem Tag="64000" Content="ISO 64000" />
              <ComboBoxItem Tag="102400" Content="ISO 102400" />
