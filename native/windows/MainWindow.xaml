            <ComboBox x:Name="WhiteBalanceBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="continuous" Content="自动" IsSelected="True" />
              <ComboBoxItem Tag="manual" Content="预设手动" />
            </ComboBox>

            <TextBlock Text="优化校准" />
            <ComboBox x:Name="PictureControlBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="auto" Content="自动" />
              <ComboBoxItem Tag="standard" Content="标准" IsSelected="True" />
              <ComboBoxItem Tag="neutral" Content="自然" />
              <ComboBoxItem Tag="vivid" Content="鲜艳" />
              <ComboBoxItem Tag="monochrome" Content="单色" />
              <ComboBoxItem Tag="portrait" Content="人像" />
              <ComboBoxItem Tag="landscape" Content="风景" />
              <ComboBoxItem Tag="flat" Content="平面" />
            </ComboBox>

            <Expander x:Name="ProfessionalMonitorPanel"
                      Margin="0,16,0,0"
                      Header="专业监看"
                      Visibility="Collapsed"
                      IsExpanded="True">
              <StackPanel Margin="0,8,0,0">
                <CheckBox x:Name="FocusPeakingCheck"
                          Content="峰值对焦"
                          Click="FocusPeakingCheck_Click" />
                <CheckBox x:Name="FalseColorCheck"
                          Margin="0,6,0,0"
                          Content="假色曝光"
                          Click="FalseColorCheck_Click" />
                <Border Margin="0,10,0,0"
                        Padding="4"
                        Background="#000000">
                  <StackPanel>
                    <local:WaveformScope x:Name="ProfessionalScope"
                                         Mode="Professional"
                                         Height="210"
                                         AutomationProperties.Name="专业波形图，亮度、YUV 与 RGB 分量" />
                    <TextBlock x:Name="PeakingCoverageText"
                               Margin="0,6,0,0"
                               Foreground="#BFFFFFFF"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               Text="峰值覆盖 0%" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="{StaticResource GraphiteBrush}"
            BorderBrush="{StaticResource GraphiteRuleBrush}"
            BorderThickness="0,1,0,0">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="OperationStatusText"
                   Grid.Column="0"
                   Margin="0,0,14,0"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource GraphiteInkBrush}"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   Text="就绪" />
        <TextBlock x:Name="PhotoCountText"
                   Grid.Column="1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource GraphiteMutedBrush}"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="11"
                   Text="0 张照片" />
      </Grid>
    </Border>
  </Grid>
</Window>
