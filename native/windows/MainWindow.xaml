              <ComboBoxItem Tag="4" Content="f/4" IsSelected="True" />
              <ComboBoxItem Tag="5.6" Content="f/5.6" />
              <ComboBoxItem Tag="8" Content="f/8" />
              <ComboBoxItem Tag="11" Content="f/11" />
              <ComboBoxItem Tag="16" Content="f/16" />
