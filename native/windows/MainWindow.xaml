                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="single-shot" Content="AF-S · 单次自动对焦" IsSelected="True" />
              <ComboBoxItem Tag="continuous" Content="AF-C · 连续自动对焦" />
              <ComboBoxItem Tag="manual" Content="MF · 手动对焦" />
            </ComboBox>

