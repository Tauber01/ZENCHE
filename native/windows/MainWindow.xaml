<Window x:Class="NikonLink.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NikonLink.Windows"
        Title="帧澈 ZENCHE"
        Icon="Assets/icon-512.png"
        Width="1280"
        Height="820"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="76" />
      <RowDefinition Height="*" />
      <RowDefinition Height="34" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource RuleBrush}"
            BorderThickness="0,0,0,1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="14"
                          Color="{StaticResource ColorShadow}"
                          Opacity="0.35"
                          ShadowDepth="3" />
      </Border.Effect>
      <Grid Margin="20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
          <Border Width="44"
                  Height="44"
                  CornerRadius="13">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{StaticResource ColorAccent}" />
                <GradientStop Offset="1" Color="#2E86E0" />
              </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
              <DropShadowEffect BlurRadius="10"
                                Color="{StaticResource ColorAccent}"
                                Opacity="0.2"
                                ShadowDepth="4" />
            </Border.Effect>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       Text="Z" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock FontFamily="{StaticResource DisplayFont}"
                       FontSize="19"
                       FontWeight="Bold"
                       Foreground="{StaticResource InkBrush}"
                       Text="帧澈 ZENCHE" />
            <TextBlock Margin="0,3,0,0"
                       Style="{StaticResource MetaText}"
                       Text="Capture · Connect · Flow" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1"
                Margin="16,0"
                Padding="12,8"
                VerticalAlignment="Center"
                Background="{StaticResource Paper2Brush}"
                BorderBrush="{StaticResource RuleBrush}"
                BorderThickness="1"
                CornerRadius="18">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="ConnectionDot"
                     Width="8"
                     Height="8"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"
                     Fill="{StaticResource MutedBrush}" />
            <TextBlock x:Name="CameraStatusText"
                       Style="{StaticResource MetaText}"
                       MaxWidth="260"
                       Text="未连接 · WINDOWS USB/PTP"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
          </StackPanel>
        </Border>
        <Button x:Name="ConnectButton"
                Grid.Column="2"
                Width="142"
                Style="{StaticResource PrimaryButton}"
                Content="连接管理"
                Click="ConnectButton_Click" />
        <Button x:Name="SettingsButton"
                Grid.Column="3"
                Width="48"
                Margin="10,0,0,0"
                FontFamily="Segoe UI Symbol"
                FontSize="20"
                Style="{StaticResource ButtonBase}"
                Content="⚙"
                ToolTip="设置"
                Click="SettingsButton_Click" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="176" />
        <ColumnDefinition Width="*" MinWidth="380" />
        <ColumnDefinition x:Name="ParameterColumn" Width="300" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{StaticResource SidebarBrush}"
              BorderBrush="{StaticResource RuleBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel Margin="18">
          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Style="{StaticResource MetaText}" Text="ZENCHE 1.5.1" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Text="照片保存在“图片\帧澈 ZENCHE”" />
          </StackPanel>
          <StackPanel>
            <TextBlock Margin="12,0,0,16"
                       Style="{StaticResource MetaText}"
                       Text="工作区" />
            <Button x:Name="CaptureNav"
                    Style="{StaticResource NavButton}"
                    Tag="capture"
                    Content="照片拍摄"
                    Click="Navigate_Click" />
            <Button x:Name="MonitorNav"
                    Style="{StaticResource NavButton}"
                    Tag="monitor"
                    Content="视频监看"
                    Click="Navigate_Click" />
            <Button x:Name="EditorNav"
                    Style="{StaticResource NavButton}"
                    Tag="editor"
                    Content="图像编辑"
                    Click="Navigate_Click" />
            <Button x:Name="DevicesNav"
                    Style="{StaticResource NavButton}"
                    Tag="devices"
                    Content="我的设备"
                    Click="Navigate_Click" />
            <Button x:Name="LibraryNav"
                    Style="{StaticResource NavButton}"
                    Tag="library"
                    Content="分支文件库"
                    Click="Navigate_Click" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="24">
        <Grid x:Name="MonitorDashboard" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#060B14" Padding="20,16" BorderBrush="#152131" BorderThickness="1,1,1,0">
            <Grid>
              <TextBlock x:Name="MonitorTimecodeText" Text="00:00:00:00" FontFamily="{StaticResource MonoFont}" FontSize="38" FontWeight="SemiBold" Foreground="White" />
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#26D07C" />
                <TextBlock x:Name="MonitorLiveStatusText" Text="NO SOURCE" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold" Foreground="#B9C2CE" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="#060B14" BorderBrush="#152131" BorderThickness="1,0,1,0" ClipToBounds="True">
            <Grid>
              <Image x:Name="MonitorPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" MouseLeftButtonUp="MonitorPreviewImage_MouseLeftButtonUp" />
              <TextBlock x:Name="MonitorFocusReticle" Text="＋" Visibility="Collapsed" Foreground="#FFE45C" FontSize="38" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" />
              <StackPanel x:Name="MonitorPreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" Text="等待实时取景画面" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" Foreground="#F0F3F8" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Text="连接相机后开启实时取景" Foreground="#ADB5C1" />
              </StackPanel>
              <TextBlock x:Name="MonitorCameraOverlay" Margin="16" VerticalAlignment="Top" Text="未连接 · USB/PTP" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#D7DEE8" />
            </Grid>
          </Border>
          <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,12,0" Padding="3" Background="#000000">
              <local:WaveformScope x:Name="MonitorRgbScope"
                                   Mode="RgbParade"
                                   Height="98"
                                   AutomationProperties.Name="RGB 波形" />
            </Border>
            <Button x:Name="MonitorRecordButton" Grid.Column="1" Width="108" Height="108" Style="{StaticResource ButtonBase}" Click="ShutterButton_Click" ToolTip="开始或停止录制">
              <Grid>
                <Ellipse Width="96" Height="96" Stroke="White" StrokeThickness="2" />
                <Ellipse Width="58" Height="58" Fill="{StaticResource VideoBrush}" />
              </Grid>
            </Button>
            <Border Grid.Column="2" Margin="12,0,0,0" Padding="3" Background="#000000">
              <local:WaveformScope Mode="Audio"
                                   Height="98"
                                   AutomationProperties.Name="音频波形，无音频源，静音基线" />
            </Border>
          </Grid>
          <UniformGrid Grid.Row="3" Columns="7" Margin="0,18,0,0">
            <StackPanel Margin="4"><TextBlock Text="帧率" Foreground="#ADB5C1" FontSize="11" /><TextBlock x:Name="MonitorFrameRateText" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" Foreground="White" /></StackPanel>
            <StackPanel Margin="4"><TextBlock Text="快门" Foreground="#ADB5C1" FontSize="11" /><TextBlock x:Name="MonitorShutterText" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" Foreground="White" /></StackPanel>
            <StackPanel Margin="4"><TextBlock Text="光圈" Foreground="#ADB5C1" FontSize="11" /><TextBlock x:Name="MonitorApertureText" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" Foreground="White" /></StackPanel>
            <StackPanel Margin="4"><TextBlock Text="ISO" Foreground="#ADB5C1" FontSize="11" /><TextBlock x:Name="MonitorIsoText" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" Foreground="White" /></StackPanel>
            <StackPanel Margin="4"><TextBlock Text="白平衡" Foreground="#ADB5C1" FontSize="11" /><TextBlock x:Name="MonitorWhiteBalanceText" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" Foreground="White" /></StackPanel>
            <StackPanel Margin="4"><TextBlock Text="编码" Foreground="#ADB5C1" FontSize="11" /><TextBlock x:Name="MonitorCodecText" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" Foreground="White" /></StackPanel>
            <StackPanel Margin="4"><TextBlock Text="色调" Foreground="#ADB5C1" FontSize="11" /><TextBlock x:Name="MonitorToneText" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" Foreground="White" /></StackPanel>
          </UniformGrid>
          <StackPanel Grid.Row="4" Margin="0,16,0,4">
            <Border MaxWidth="720"
                    HorizontalAlignment="Center"
                    Padding="12,10"
                    Background="{StaticResource Graphite2Brush}"
                    BorderBrush="#304E70"
                    BorderThickness="1"
                    CornerRadius="14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" Background="{StaticResource AccentBrush}" CornerRadius="12">
                  <TextBlock HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="11"
                             FontWeight="Bold"
                             Foreground="White"
                             Text="NP3" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource GraphiteInkBrush}" Text="尼康云创监看" />
                  <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource GraphiteMutedBrush}" Text="107 款设备端 SDR 预设" />
                </StackPanel>
                <ComboBox x:Name="MonitorNikonCloudPresetBox"
                          Grid.Column="2"
                          Height="44"
                          Margin="0"
                          MaxDropDownHeight="360"
                          IsTextSearchEnabled="True"
                          StaysOpenOnEdit="False"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          TextSearch.TextPath="Content"
                          AutomationProperties.Name="选择尼康云创监看预设"
                          SelectionChanged="MonitorNikonCloudPresetBox_SelectionChanged" />
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           FontSize="11"
                           Foreground="{StaticResource GraphiteMutedBrush}"
                           Text="照片与视频实时生效 · SDR 近似 · 不写入原片" />
              </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
              <Button x:Name="MonitorFocusButton" Style="{StaticResource MonitorIconButton}" Tag="focus" Content="◎\n峰值" Click="MonitorFocusButton_Click" />
              <Button x:Name="MonitorLutButton" Style="{StaticResource MonitorIconButton}" Tag="lut" Content="LUT\nLUT" Click="MonitorLutButton_Click" />
              <Button x:Name="MonitorFalseColorButton" Style="{StaticResource MonitorIconButton}" Tag="false" Content="◉\n假色" Click="MonitorFalseColorButton_Click" />
              <Button x:Name="MonitorZebraButton" Style="{StaticResource MonitorIconButton}" Tag="zebra" Content="±\n斑马" Click="MonitorZebraButton_Click" />
              <Button x:Name="MonitorAutoFocusButton" Style="{StaticResource MonitorIconButton}" Tag="af" Content="◎A\nAF-ON" Click="MonitorAutoFocusButton_Click" />
              <Button x:Name="MonitorLiveViewButton" Style="{StaticResource MonitorIconButton}" Content="▣\n取景" Click="LiveViewButton_Click" />
            </StackPanel>
          </StackPanel>
          <Border Grid.Row="5" Margin="0,24,0,0" Padding="16" HorizontalAlignment="Center" Background="#1A212D" CornerRadius="10">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="▯" FontSize="28" Foreground="White" VerticalAlignment="Center" />
              <StackPanel Margin="12,0,0,0"><TextBlock x:Name="MonitorStorageFreeText" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" Foreground="White" /><TextBlock x:Name="MonitorStorageDetailText" Text="本地缓存 · 存储状态暂不可用" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#ADB5C1" /></StackPanel>
            </StackPanel>
          </Border>
        </Grid>
        <Grid x:Name="CapturePanel">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Expander Grid.Row="3"
                    Margin="0,14,0,0"
                    Header="拍前会话与交付"
                    IsExpanded="False">
            <Border Padding="14" Style="{StaticResource PanelCard}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                  <TextBlock Text="项目名称" />
                  <TextBox x:Name="SessionNameText" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                  <TextBlock Text="命名模板" />
                  <TextBox x:Name="SessionNamingTemplateText" FontFamily="{StaticResource MonoFont}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                  <TextBlock Text="默认评级" />
                  <ComboBox x:Name="SessionRatingBox" SelectedIndex="0">
                    <ComboBoxItem Content="0 星" Tag="0" />
                    <ComboBoxItem Content="1 星" Tag="1" />
                    <ComboBoxItem Content="2 星" Tag="2" />
                    <ComboBoxItem Content="3 星" Tag="3" />
                    <ComboBoxItem Content="4 星" Tag="4" />
                    <ComboBoxItem Content="5 星" Tag="5" />
                  </ComboBox>
                </StackPanel>
                <CheckBox x:Name="SessionDualBackupCheck"
                          Grid.Column="3"
                          Margin="0,20,0,0"
                          VerticalAlignment="Center"
                          Content="双目标备份"
                          IsChecked="True" />
                <StackPanel Grid.Row="1" Margin="0,10,10,0">
                  <TextBlock Text="创作者" />
                  <TextBox x:Name="SessionCreatorText" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,10,0">
                  <TextBlock Text="版权" />
                  <TextBox x:Name="SessionRightsText" />
                </StackPanel>
                <TextBlock x:Name="SessionStatusText"
                           Grid.Row="2"
                           Grid.ColumnSpan="3"
                           Margin="0,12,12,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="尚未开始拍摄会话" />
                <Button x:Name="SessionActionButton"
                        Grid.Row="2"
                        Grid.Column="3"
                        Height="42"
                        Margin="0,10,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="开始会话"
                        Click="SessionActionButton_Click" />
              </Grid>
            </Border>
          </Expander>
          <Border Grid.Row="0"
                  Background="{StaticResource GraphiteBrush}"
                  BorderBrush="{StaticResource GraphiteRuleBrush}"
                  BorderThickness="1"
                  CornerRadius="18"
                  ClipToBounds="True">
            <Grid>
              <Image x:Name="PreviewImage"
                     Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel x:Name="PreviewEmpty"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{StaticResource GraphiteInkBrush}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="22"
                           FontWeight="Bold"
                           Text="等待相机画面" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource GraphiteMutedBrush}"
                           Text="连接相机后开启实时取景" />
              </StackPanel>
              <Border HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="16"
                      Padding="8,4"
                      CornerRadius="5"
                      Background="{StaticResource Graphite2Brush}">
                <TextBlock x:Name="LiveBadge"
                           Style="{StaticResource MetaText}"
                           Foreground="{StaticResource GraphiteMutedBrush}"
                           Text="LIVE VIEW OFF" />
              </Border>
              <Button HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Width="96"
                      Height="42"
                      Margin="16"
                      Style="{StaticResource ButtonBase}"
                      Content="全屏"
                      Click="FullscreenPreviewButton_Click" />
            </Grid>
          </Border>
          <Border Grid.Row="1"
                  Height="82"
                  Margin="0,14,0,0"
                  Background="{StaticResource GraphiteBrush}"
                  BorderBrush="{StaticResource GraphiteRuleBrush}"
                  BorderThickness="1"
                  CornerRadius="14">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal" Margin="8,0">
                <StackPanel Width="104" Margin="12,13">
                  <TextBlock Style="{StaticResource MetaText}" Foreground="{StaticResource GraphiteMutedBrush}" Text="来源" />
                  <TextBlock x:Name="SourceReadoutText" Margin="0,5,0,0" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GraphiteInkBrush}" Text="—" />
                </StackPanel>
                <Border Width="1" Height="42" VerticalAlignment="Center" Background="#1FFFFFFF" />
                <StackPanel Width="82" Margin="12,13">
                  <TextBlock Style="{StaticResource MetaText}" Foreground="{StaticResource GraphiteMutedBrush}" Text="模式" />
                  <TextBlock x:Name="ModeReadoutText" Margin="0,5,0,0" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GraphiteInkBrush}" Text="—" />
                </StackPanel>
                <Border Width="1" Height="42" VerticalAlignment="Center" Background="#1FFFFFFF" />
                <StackPanel Width="116" Margin="12,13">
                  <TextBlock x:Name="ShutterReadoutLabel" Style="{StaticResource MetaText}" Foreground="{StaticResource GraphiteMutedBrush}" Text="快门" />
                  <TextBlock x:Name="ShutterReadoutText" Margin="0,5,0,0" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GraphiteInkBrush}" Text="—" />
                </StackPanel>
                <Border Width="1" Height="42" VerticalAlignment="Center" Background="#1FFFFFFF" />
                <StackPanel Width="104" Margin="12,13">
                  <TextBlock x:Name="ApertureReadoutLabel" Style="{StaticResource MetaText}" Foreground="{StaticResource GraphiteMutedBrush}" Text="光圈" />
                  <TextBlock x:Name="ApertureReadoutText" Margin="0,5,0,0" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GraphiteInkBrush}" Text="—" />
                </StackPanel>
                <Border Width="1" Height="42" VerticalAlignment="Center" Background="#1FFFFFFF" />
                <StackPanel Width="96" Margin="12,13">
                  <TextBlock x:Name="IsoReadoutLabel" Style="{StaticResource MetaText}" Foreground="{StaticResource GraphiteMutedBrush}" Text="ISO" />
                  <TextBlock x:Name="IsoReadoutText" Margin="0,5,0,0" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GraphiteInkBrush}" Text="—" />
                </StackPanel>
                <Border Width="1" Height="42" VerticalAlignment="Center" Background="#1FFFFFFF" />
                <StackPanel Width="132" Margin="12,13">
                  <TextBlock x:Name="CompensationReadoutLabel" Style="{StaticResource MetaText}" Foreground="{StaticResource GraphiteMutedBrush}" Text="曝光补偿" />
                  <TextBlock x:Name="CompensationReadoutText" Margin="0,5,0,0" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GraphiteInkBrush}" Text="—" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="PreviewDetailText"
                         Foreground="{StaticResource MutedBrush}"
                         Text="相机原生 JPEG · 本地预览" />
              <Border Margin="0,8,0,0"
                      Padding="12,10"
                      Background="{StaticResource AccentSoftBrush}"
                      BorderBrush="{StaticResource AccentBrush}"
                      BorderThickness="1"
                      CornerRadius="14">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                  </Grid.ColumnDefinitions>
                  <Border Width="40" Height="40" Background="{StaticResource AccentBrush}" CornerRadius="12">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="NP3" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="尼康云创监看" />
                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="107 款设备端 SDR 预设" />
                  </StackPanel>
                  <ComboBox x:Name="CaptureNikonCloudPresetBox"
                            Grid.Column="2"
                            Height="44"
                            Margin="0"
                            MaxDropDownHeight="360"
                            IsTextSearchEnabled="True"
                            StaysOpenOnEdit="False"
                            ScrollViewer.CanContentScroll="True"
                            VirtualizingStackPanel.IsVirtualizing="True"
                            TextSearch.TextPath="Content"
                            AutomationProperties.Name="选择尼康云创监看预设"
                            SelectionChanged="MonitorNikonCloudPresetBox_SelectionChanged" />
                  <TextBlock Grid.Row="1"
                             Grid.ColumnSpan="3"
                             Margin="0,8,0,0"
                             FontSize="11"
                             Foreground="{StaticResource MutedBrush}"
                             Text="照片与视频实时生效 · SDR 近似 · 不写入原片" />
                </Grid>
              </Border>
            </StackPanel>
            <Button x:Name="LiveViewButton"
                    Grid.Column="1"
                    Width="132"
                    Margin="8,0"
                    Style="{StaticResource ButtonBase}"
                    Content="开启取景"
                    IsEnabled="False"
                    Click="LiveViewButton_Click" />
            <Button x:Name="ShutterButton"
                    Grid.Column="3"
                    Width="132"
                    Style="{StaticResource PrimaryButton}"
                    Content="拍摄照片"
                    IsEnabled="False"
                    Click="ShutterButton_Click" />
            <Button x:Name="CaptureAutoFocusButton"
                    Grid.Column="2"
                    Width="110"
                    Margin="8,0,0,0"
                    Style="{StaticResource ButtonBase}"
                    Content="AF-ON"
                    IsEnabled="False"
                    Click="CaptureAutoFocusButton_Click" />
          </Grid>
