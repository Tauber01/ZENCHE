                  </WrapPanel>
                  <Grid Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <PasswordBox x:Name="MirrorChyanCdkBox"
                                   Height="38"
                                   Padding="10,7"
                                   ToolTip="Mirror酱 CDK（可选）" />
