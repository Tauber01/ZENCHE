<Window x:Class="NikonLink.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帧澈 ZENCHE"
        Icon="Assets/icon-512.png"
        Width="1280"
        Height="820"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="68" />
      <RowDefinition Height="*" />
      <RowDefinition Height="34" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource RuleBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Style="{StaticResource DisplayText}"
                     Text="帧澈 ZENCHE  ·  Capture · Connect · Flow" />
          <TextBlock x:Name="CameraStatusText"
                     Style="{StaticResource MetaText}"
                     Text="未连接 · WINDOWS USB/PTP" />
        </StackPanel>
        <Button x:Name="ConnectButton"
                Grid.Column="1"
                Width="142"
                Style="{StaticResource PrimaryButton}"
                Content="连接相机"
                Click="ConnectButton_Click" />
        <Button x:Name="SettingsButton"
                Grid.Column="2"
                Width="76"
                Margin="10,0,0,0"
                Style="{StaticResource ButtonBase}"
                Content="设置"
                Click="SettingsButton_Click" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="*" MinWidth="380" />
        <ColumnDefinition x:Name="ParameterColumn" Width="300" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{StaticResource Paper2Brush}"
              BorderBrush="{StaticResource RuleBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel Margin="16">
          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Style="{StaticResource MetaText}" Text="NIKON LINK 0.8.3" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Text="照片保存在“图片\帧澈 ZENCHE”" />
          </StackPanel>
          <StackPanel>
            <TextBlock Margin="12,0,0,12"
                       Style="{StaticResource MetaText}"
                       Text="工作区" />
            <Button x:Name="CaptureNav"
                    Style="{StaticResource NavButton}"
                    Tag="capture"
                    Content="照片拍摄"
                    Click="Navigate_Click" />
            <Button x:Name="MonitorNav"
                    Style="{StaticResource NavButton}"
                    Tag="monitor"
                    Content="视频监看"
                    Click="Navigate_Click" />
            <Button x:Name="LibraryNav"
                    Style="{StaticResource NavButton}"
                    Tag="library"
                    Content="文件与传输"
                    Click="Navigate_Click" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="20">
        <Grid x:Name="CapturePanel">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Background="{StaticResource GraphiteBrush}"
                  BorderBrush="{StaticResource GraphiteRuleBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  ClipToBounds="True">
            <Grid>
              <Image x:Name="PreviewImage"
                     Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel x:Name="PreviewEmpty"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{StaticResource GraphiteInkBrush}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="22"
                           FontWeight="Bold"
                           Text="等待相机画面" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource GraphiteMutedBrush}"
                           Text="连接相机后开启实时取景" />
              </StackPanel>
              <Border HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="16"
                      Padding="8,4"
                      CornerRadius="5"
                      Background="{StaticResource Graphite2Brush}">
                <TextBlock x:Name="LiveBadge"
                           Style="{StaticResource MetaText}"
                           Foreground="{StaticResource GraphiteMutedBrush}"
                           Text="LIVE VIEW OFF" />
              </Border>
              <Button HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Width="96"
                      Height="42"
                      Margin="16"
                      Style="{StaticResource ButtonBase}"
                      Content="全屏"
                      Click="FullscreenPreviewButton_Click" />
            </Grid>
          </Border>
          <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PreviewDetailText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       Text="相机原生 JPEG · 本地预览" />
            <Button x:Name="LiveViewButton"
                    Grid.Column="1"
                    Width="132"
                    Margin="8,0"
                    Style="{StaticResource ButtonBase}"
                    Content="开启取景"
                    IsEnabled="False"
                    Click="LiveViewButton_Click" />
            <Button x:Name="ShutterButton"
                    Grid.Column="2"
                    Width="132"
                    Style="{StaticResource PrimaryButton}"
                    Content="拍摄照片"
                    IsEnabled="False"
                    Click="ShutterButton_Click" />
          </Grid>
        </Grid>

        <Grid x:Name="LibraryPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel>
              <TextBlock Style="{StaticResource DisplayText}" Text="文件与传输" />
              <TextBlock Margin="0,4,0,0"
                         Foreground="{StaticResource MutedBrush}"
                         Text="系统“图片”与 帧澈 ZENCHE 文件库会直接合并显示；来源标注在每个文件下方。" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
              <Button Width="112"
                      Style="{StaticResource ButtonBase}"
                      Content="刷新相册"
                      Click="OpenOwnerAlbum_Click" />
              <Button Width="112"
                      Margin="8,0,0,0"
                      Style="{StaticResource ButtonBase}"
                      Content="链接网盘"
                      Click="LinkCloudDrive_Click" />
              <Button Width="112"
                      Margin="8,0,0,0"
                      Style="{StaticResource ButtonBase}"
                      Content="打开目录"
                      Click="OpenPhotoFolder_Click" />
            </StackPanel>
          </Grid>
          <Expander Grid.Row="1"
                    Margin="0,18,0,0"
                    Header="无线传输 · FTP / HTTP / WebDAV"
                    IsExpanded="False">
          <Border Padding="16"
                  Style="{StaticResource PanelCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="多协议无线图片收件箱" />
                <TextBlock x:Name="WirelessStatusText"
                           FontWeight="SemiBold"
                           Text="无线收件箱未开启" />
                <TextBlock x:Name="WirelessAddressText"
                           Margin="0,6,0,0"
                           FontFamily="{StaticResource MonoFont}"
                           Foreground="{StaticResource AccentBrush}"
                           Text="—" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Text="FTP/PASV 端口 2121 · HTTP/WebDAV 端口 8080 · 用户名/密码 nikonlink · 接收完成后自动进入文件库" />
              </StackPanel>
              <Button x:Name="WirelessButton"
                      Grid.Column="1"
                      Width="150"
                      Margin="18,0,0,0"
                      VerticalAlignment="Center"
                      Style="{StaticResource PrimaryButton}"
                      Content="开启无线接收"
                      Click="WirelessButton_Click" />
            </Grid>
          </Border>
          </Expander>
          <ListBox x:Name="PhotoList"
                   Grid.Row="2"
                   Margin="0,20,0,12"
                   Background="Transparent"
                   BorderBrush="{StaticResource RuleBrush}"
                   BorderThickness="1"
                   MouseDoubleClick="PhotoList_MouseDoubleClick"
                   SelectionChanged="PhotoList_SelectionChanged">
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.ContainerStyle>
                  <Style TargetType="{x:Type GroupItem}">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GroupItem}">
                          <Expander Margin="8,6"
                                    IsExpanded="True"
                                    Background="{StaticResource SurfaceBrush}">
                            <Expander.Header>
                              <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="Bold"
                                           Text="{Binding Name}" />
                                <TextBlock Margin="8,0,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding ItemCount, StringFormat=· {0}}" />
                              </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter Margin="12,4,0,8" />
                          </Expander>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </GroupStyle.ContainerStyle>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource MetaText}"
                               Text="{Binding Detail}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource MutedBrush}"
                             Text="›" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="3"
                      HorizontalAlignment="Right"
                      Orientation="Horizontal">
            <TextBlock Margin="0,0,18,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       Text="双击文件查看大图" />
            <Button x:Name="SharePhotoButton"
                    Width="150"
                    Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButton}"
                    Content="分享到社交平台"
                    IsEnabled="False"
                    Click="SharePhotoButton_Click" />
            <Button x:Name="DeletePhotoButton"
                    Width="118"
                    Style="{StaticResource DangerButton}"
                    Content="删除所选"
                    IsEnabled="False"
                    Click="DeletePhotoButton_Click" />
          </StackPanel>
        </Grid>

        <Grid x:Name="SettingsPanel" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="680" HorizontalAlignment="Left">
              <TextBlock Style="{StaticResource DisplayText}" Text="设置" />
              <TextBlock Margin="0,12,0,24"
                         Foreground="{StaticResource MutedBrush}"
                         Text="更新、诊断与应用支持。" />
              <Border Style="{StaticResource PanelCard}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="软件更新" />
                    <TextBlock x:Name="CurrentVersionText"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="UpdateStatusText"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               Text="尚未检查更新" />
                  </StackPanel>
                  <WrapPanel Grid.Column="1"
                             Margin="18,0,0,0"
                             VerticalAlignment="Center">
                    <Button x:Name="CheckUpdateButton"
                            Width="112"
                            Margin="0,0,8,0"
                            Style="{StaticResource ButtonBase}"
                            Content="检查更新"
                            Click="CheckUpdateButton_Click" />
                    <Button x:Name="OpenUpdateButton"
                            Width="132"
                            Style="{StaticResource PrimaryButton}"
                            Content="获取更新"
                            Visibility="Collapsed"
                            Click="OpenUpdateButton_Click" />
                  </WrapPanel>
                </Grid>
              </Border>
              <Border Margin="0,20,0,0" Style="{StaticResource PanelCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitle}" Text="诊断日志" />
                  <TextBlock x:Name="DiagnosticLogPathText"
                             Margin="0,0,0,16"
                             FontFamily="{StaticResource MonoFont}"
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap" />
                  <WrapPanel>
                    <Button Width="112"
                            Margin="0,0,8,0"
                            Style="{StaticResource ButtonBase}"
                            Content="查询日志"
                            Click="ViewLogs_Click" />
                    <Button Width="132"
                            Margin="0,0,8,0"
                            Style="{StaticResource ButtonBase}"
                            Content="打开日志目录"
                            Click="OpenLogFolder_Click" />
                    <Button Width="168"
                            Style="{StaticResource PrimaryButton}"
                            Content="上传脱敏日志"
                            Click="ReportIssue_Click" />
                  </WrapPanel>
                  <TextBlock Margin="0,12,0,0"
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap"
                             Text="将打开含最近脱敏日志的预填页面；在 GitHub 确认后才会提交。" />
                </StackPanel>
              </Border>
              <Border Margin="0,20,0,0" Style="{StaticResource PanelCard}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="喜欢 帧澈 ZENCHE？" />
                    <TextBlock Foreground="{StaticResource MutedBrush}"
                               Text="请作者喝杯奶茶，支持维护和新机型适配。" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Width="160"
                          Margin="18,0,0,0"
                          Style="{StaticResource PrimaryButton}"
                          Content="请作者喝奶茶"
                          Click="DonationButton_Click" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <Border x:Name="ParameterPanelShell"
              Grid.Column="2"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource RuleBrush}"
              BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20">
            <TextBlock x:Name="ParameterPanelTitle"
                       Style="{StaticResource SectionTitle}"
                       Text="照片曝光与参数" />
            <TextBlock Text="拍摄模式" />
            <ComboBox x:Name="ExposureModeBox"
                      SelectionChanged="ExposureModeBox_SelectionChanged">
              <ComboBoxItem Tag="program" Content="P · 程序自动" />
              <ComboBoxItem Tag="shutterPriority" Content="S · 快门优先" />
              <ComboBoxItem Tag="aperturePriority" Content="A · 光圈优先" />
              <ComboBoxItem Tag="manual" Content="M · 手动" IsSelected="True" />
              <ComboBoxItem Tag="bulb" Content="M · B门" />
            </ComboBox>

            <TextBlock x:Name="VideoFrameRateLabel"
                       Text="快门角度换算帧率"
                       Visibility="Collapsed" />
            <ComboBox x:Name="VideoFrameRateBox"
                      Visibility="Collapsed"
                      SelectionChanged="VideoFrameRateBox_SelectionChanged">
              <ComboBoxItem Tag="24" Content="24 fps" />
              <ComboBoxItem Tag="25" Content="25 fps" />
              <ComboBoxItem Tag="30" Content="30 fps" IsSelected="True" />
              <ComboBoxItem Tag="50" Content="50 fps" />
              <ComboBoxItem Tag="60" Content="60 fps" />
            </ComboBox>

            <TextBlock x:Name="ShutterLabel" Text="快门速度" />
            <ComboBox x:Name="ShutterBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="0.000125" Content="1/8000 s" />
              <ComboBoxItem Tag="0.001" Content="1/1000 s" />
              <ComboBoxItem Tag="0.004" Content="1/250 s" />
              <ComboBoxItem Tag="0.008" Content="1/125 s" IsSelected="True" />
              <ComboBoxItem Tag="0.016667" Content="1/60 s" />
              <ComboBoxItem Tag="1" Content="1 s" />
              <ComboBoxItem Tag="30" Content="30 s" />
            </ComboBox>

            <TextBlock Text="光圈" />
            <ComboBox x:Name="ApertureBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="1.4" Content="f/1.4" />
              <ComboBoxItem Tag="2.8" Content="f/2.8" />
              <ComboBoxItem Tag="4" Content="f/4" IsSelected="True" />
              <ComboBoxItem Tag="5.6" Content="f/5.6" />
              <ComboBoxItem Tag="8" Content="f/8" />
              <ComboBoxItem Tag="11" Content="f/11" />
              <ComboBoxItem Tag="16" Content="f/16" />
            </ComboBox>

            <TextBlock Text="ISO 感光度" />
            <ComboBox x:Name="IsoBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="64" Content="ISO 64" />
              <ComboBoxItem Tag="100" Content="ISO 100" />
              <ComboBoxItem Tag="200" Content="ISO 200" />
              <ComboBoxItem Tag="400" Content="ISO 400" IsSelected="True" />
              <ComboBoxItem Tag="800" Content="ISO 800" />
              <ComboBoxItem Tag="1600" Content="ISO 1600" />
              <ComboBoxItem Tag="3200" Content="ISO 3200" />
              <ComboBoxItem Tag="6400" Content="ISO 6400" />
              <ComboBoxItem Tag="12800" Content="ISO 12800" />
              <ComboBoxItem Tag="25600" Content="ISO 25600" />
              <ComboBoxItem Tag="51200" Content="ISO 51200" />
              <ComboBoxItem Tag="64000" Content="ISO 64000" />
              <ComboBoxItem Tag="102400" Content="ISO 102400" />
            </ComboBox>

            <TextBlock Text="曝光补偿" />
            <ComboBox x:Name="ExposureCompensationBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="-2" Content="-2 EV" />
              <ComboBoxItem Tag="-1" Content="-1 EV" />
              <ComboBoxItem Tag="0" Content="0 EV" IsSelected="True" />
              <ComboBoxItem Tag="1" Content="+1 EV" />
              <ComboBoxItem Tag="2" Content="+2 EV" />
            </ComboBox>

            <TextBlock Text="对焦模式" />
            <ComboBox x:Name="FocusModeBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="single-shot" Content="AF-S · 单次自动对焦" IsSelected="True" />
              <ComboBoxItem Tag="continuous" Content="AF-C · 连续自动对焦" />
              <ComboBoxItem Tag="manual" Content="MF · 手动对焦" />
            </ComboBox>

            <TextBlock Text="白平衡" />
            <ComboBox x:Name="WhiteBalanceBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="continuous" Content="自动" IsSelected="True" />
              <ComboBoxItem Tag="manual" Content="预设手动" />
            </ComboBox>

            <TextBlock Text="优化校准" />
            <ComboBox x:Name="PictureControlBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="auto" Content="自动" />
              <ComboBoxItem Tag="standard" Content="标准" IsSelected="True" />
              <ComboBoxItem Tag="neutral" Content="自然" />
              <ComboBoxItem Tag="vivid" Content="鲜艳" />
              <ComboBoxItem Tag="monochrome" Content="单色" />
              <ComboBoxItem Tag="portrait" Content="人像" />
              <ComboBoxItem Tag="landscape" Content="风景" />
              <ComboBoxItem Tag="flat" Content="平面" />
            </ComboBox>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="{StaticResource GraphiteBrush}"
            BorderBrush="{StaticResource GraphiteRuleBrush}"
            BorderThickness="0,1,0,0">
      <Grid Margin="16,0">
        <TextBlock x:Name="OperationStatusText"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource GraphiteInkBrush}"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="11"
                   Text="就绪" />
        <TextBlock x:Name="PhotoCountText"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource GraphiteMutedBrush}"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="11"
                   Text="0 张照片" />
      </Grid>
    </Border>
  </Grid>
</Window>
