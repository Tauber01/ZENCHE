<Window x:Class="NikonLink.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帧澈 ZENCHE"
        Icon="Assets/icon-512.png"
        Width="1280"
        Height="820"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="76" />
      <RowDefinition Height="*" />
      <RowDefinition Height="34" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource RuleBrush}"
            BorderThickness="0,0,0,1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="14"
                          Color="{StaticResource ColorShadow}"
                          Opacity="0.35"
                          ShadowDepth="3" />
      </Border.Effect>
      <Grid Margin="20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
          <Border Width="44"
                  Height="44"
                  Background="{StaticResource GraphiteBrush}"
                  CornerRadius="13">
            <Border.Effect>
              <DropShadowEffect BlurRadius="10"
                                Color="{StaticResource ColorAccent}"
                                Opacity="0.2"
                                ShadowDepth="4" />
            </Border.Effect>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       Text="Z" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock FontFamily="{StaticResource DisplayFont}"
                       FontSize="19"
                       FontWeight="Bold"
                       Foreground="{StaticResource InkBrush}"
                       Text="帧澈 ZENCHE" />
            <TextBlock Margin="0,3,0,0"
                       Style="{StaticResource MetaText}"
                       Text="Capture · Connect · Flow" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1"
                Margin="16,0"
                Padding="12,8"
                VerticalAlignment="Center"
                Background="{StaticResource Paper2Brush}"
                BorderBrush="{StaticResource RuleBrush}"
                BorderThickness="1"
                CornerRadius="18">
          <TextBlock x:Name="CameraStatusText"
                     Style="{StaticResource MetaText}"
                     MaxWidth="260"
                     Text="未连接 · WINDOWS USB/PTP"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap" />
        </Border>
        <Button x:Name="ConnectButton"
                Grid.Column="2"
                Width="142"
                Style="{StaticResource PrimaryButton}"
                Content="连接相机"
                Click="ConnectButton_Click" />
        <Button x:Name="SettingsButton"
                Grid.Column="3"
                Width="48"
                Margin="10,0,0,0"
                FontFamily="Segoe UI Symbol"
                FontSize="20"
                Style="{StaticResource ButtonBase}"
                Content="⚙"
                ToolTip="设置"
                Click="SettingsButton_Click" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="176" />
        <ColumnDefinition Width="*" MinWidth="380" />
        <ColumnDefinition x:Name="ParameterColumn" Width="300" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{StaticResource SidebarBrush}"
              BorderBrush="{StaticResource RuleBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel Margin="18">
          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Style="{StaticResource MetaText}" Text="ZENCHE 1.3.0" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Text="照片保存在“图片\帧澈 ZENCHE”" />
          </StackPanel>
          <StackPanel>
            <TextBlock Margin="12,0,0,16"
                       Style="{StaticResource MetaText}"
                       Text="工作区" />
            <Button x:Name="CaptureNav"
                    Style="{StaticResource NavButton}"
                    Tag="capture"
                    Content="照片拍摄"
                    Click="Navigate_Click" />
            <Button x:Name="MonitorNav"
                    Style="{StaticResource NavButton}"
                    Tag="monitor"
                    Content="视频监看"
                    Click="Navigate_Click" />
            <Button x:Name="EditorNav"
                    Style="{StaticResource NavButton}"
                    Tag="editor"
                    Content="图像编辑"
                    Click="Navigate_Click" />
            <Button x:Name="LibraryNav"
                    Style="{StaticResource NavButton}"
                    Tag="library"
                    Content="分支文件库"
                    Click="Navigate_Click" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="24">
        <Grid x:Name="CapturePanel">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Background="{StaticResource GraphiteBrush}"
                  BorderBrush="{StaticResource GraphiteRuleBrush}"
                  BorderThickness="1"
                  CornerRadius="18"
                  ClipToBounds="True">
            <Grid>
              <Image x:Name="PreviewImage"
                     Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel x:Name="PreviewEmpty"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{StaticResource GraphiteInkBrush}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="22"
                           FontWeight="Bold"
                           Text="等待相机画面" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource GraphiteMutedBrush}"
                           Text="连接相机后开启实时取景" />
              </StackPanel>
              <Border HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="16"
                      Padding="8,4"
                      CornerRadius="5"
                      Background="{StaticResource Graphite2Brush}">
                <TextBlock x:Name="LiveBadge"
                           Style="{StaticResource MetaText}"
                           Foreground="{StaticResource GraphiteMutedBrush}"
                           Text="LIVE VIEW OFF" />
              </Border>
              <Button HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Width="96"
                      Height="42"
                      Margin="16"
                      Style="{StaticResource ButtonBase}"
                      Content="全屏"
                      Click="FullscreenPreviewButton_Click" />
            </Grid>
          </Border>
          <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PreviewDetailText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       Text="相机原生 JPEG · 本地预览" />
            <Button x:Name="LiveViewButton"
                    Grid.Column="1"
                    Width="132"
                    Margin="8,0"
                    Style="{StaticResource ButtonBase}"
                    Content="开启取景"
                    IsEnabled="False"
                    Click="LiveViewButton_Click" />
            <Button x:Name="ShutterButton"
                    Grid.Column="2"
                    Width="132"
                    Style="{StaticResource PrimaryButton}"
                    Content="拍摄照片"
                    IsEnabled="False"
                    Click="ShutterButton_Click" />
          </Grid>
          <Expander x:Name="ShootingTaskPanel"
                    Grid.Row="2"
                    Margin="0,14,0,0"
                    Header="拍摄任务"
                    IsExpanded="False">
            <Border Padding="14" Style="{StaticResource PanelCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="132" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <ComboBox x:Name="ShootingTaskKindBox"
                            SelectionChanged="ShootingTaskKindBox_SelectionChanged">
                    <ComboBoxItem Tag="interval" Content="间隔拍摄" IsSelected="True" />
                    <ComboBoxItem Tag="exposure" Content="曝光包围" />
                    <ComboBoxItem Tag="focus" Content="焦点包围" />
                    <ComboBoxItem Tag="bulb" Content="B 门计时" />
                  </ComboBox>
                  <TextBlock x:Name="ShootingTaskStatusText"
                             Margin="0,6,12,0"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="11"
                             Foreground="{StaticResource MutedBrush}"
                             Text="尚未开始拍摄任务" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="张数" />
                  <TextBox x:Name="ShootingTaskCountText" Text="5" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                  <TextBlock x:Name="ShootingTaskIntervalLabel" Text="间隔（秒）" />
                  <TextBox x:Name="ShootingTaskIntervalText" Text="3" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="10,0,0,0">
                  <TextBlock Text="包围步长" />
                  <TextBox x:Name="ShootingTaskStepText" Text="1" />
                </StackPanel>
                <Button x:Name="ShootingTaskButton"
                        Grid.Column="4"
                        Height="44"
                        Margin="12,16,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="开始任务"
                        Click="ShootingTaskButton_Click" />
              </Grid>
            </Border>
          </Expander>
        </Grid>

        <Grid x:Name="LibraryPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Padding="18"
                  Background="{StaticResource AccentSoftBrush}"
                  BorderBrush="{StaticResource AccentBrush}"
                  BorderThickness="1"
                  CornerRadius="14">
            <Grid>
              <StackPanel>
                <TextBlock Foreground="{StaticResource AccentBrush}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="24"
                           FontWeight="Bold"
                           Text="分支文件库" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           Text="拖动本地文件到任意分支；拖回“未分类”即可移出分支，原文件位置保持不变。" />
              </StackPanel>
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="112"
                        Style="{StaticResource ButtonBase}"
                        Content="刷新相册"
                        Click="OpenOwnerAlbum_Click" />
                <Button Width="112"
                        Margin="8,0,0,0"
                        Style="{StaticResource ButtonBase}"
                        Content="链接网盘"
                        Click="LinkCloudDrive_Click" />
                <Button Width="112"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="新建分支"
                        Click="CreateLibraryBranch_Click" />
                <Button Width="112"
                        Margin="8,0,0,0"
                        Style="{StaticResource ButtonBase}"
                        Content="打开目录"
                        Click="OpenPhotoFolder_Click" />
              </StackPanel>
            </Grid>
          </Border>
          <Expander Grid.Row="1"
                    Margin="0,18,0,0"
                    Header="拍摄会话"
                    IsExpanded="False">
            <Border Padding="16" Style="{StaticResource PanelCard}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                  <TextBlock Text="项目名称" />
                  <TextBox x:Name="SessionNameText" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                  <TextBlock Text="命名模板" />
                  <TextBox x:Name="SessionNamingTemplateText"
                           FontFamily="{StaticResource MonoFont}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                  <TextBlock Text="默认评级" />
                  <ComboBox x:Name="SessionRatingBox" SelectedIndex="0">
                    <ComboBoxItem Content="0 星" Tag="0" />
                    <ComboBoxItem Content="1 星" Tag="1" />
                    <ComboBoxItem Content="2 星" Tag="2" />
                    <ComboBoxItem Content="3 星" Tag="3" />
                    <ComboBoxItem Content="4 星" Tag="4" />
                    <ComboBoxItem Content="5 星" Tag="5" />
                  </ComboBox>
                </StackPanel>
                <CheckBox x:Name="SessionDualBackupCheck"
                          Grid.Column="3"
                          Margin="0,20,0,0"
                          VerticalAlignment="Center"
                          Content="双目标备份"
                          IsChecked="True" />
                <StackPanel Grid.Row="1" Margin="0,10,10,0">
                  <TextBlock Text="创作者" />
                  <TextBox x:Name="SessionCreatorText" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,10,0">
                  <TextBlock Text="版权" />
                  <TextBox x:Name="SessionRightsText" />
                </StackPanel>
                <TextBlock x:Name="SessionStatusText"
                           Grid.Row="2"
                           Grid.ColumnSpan="3"
                           Margin="0,12,12,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="尚未开始拍摄会话" />
                <Button x:Name="SessionActionButton"
                        Grid.Row="2"
                        Grid.Column="3"
                        Height="42"
                        Margin="0,10,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="开始会话"
                        Click="SessionActionButton_Click" />
              </Grid>
            </Border>
          </Expander>
          <Expander Grid.Row="2"
                    Margin="0,18,0,0"
                    Header="无线传输 · FTP / HTTP / WebDAV"
                    IsExpanded="False">
          <Border Padding="16"
                  Style="{StaticResource PanelCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="多协议无线图片收件箱" />
                <TextBlock x:Name="WirelessStatusText"
                           FontWeight="SemiBold"
                           Text="无线收件箱未开启" />
                <TextBlock x:Name="WirelessAddressText"
                           Margin="0,6,0,0"
                           FontFamily="{StaticResource MonoFont}"
                           Foreground="{StaticResource AccentBrush}"
                           Text="—" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Text="FTP/PASV 端口 2121 · HTTP/WebDAV 端口 8080 · 用户名/密码 nikonlink · 接收完成后自动进入文件库" />
              </StackPanel>
              <Button x:Name="WirelessButton"
                      Grid.Column="1"
                      Width="150"
                      Margin="18,0,0,0"
                      VerticalAlignment="Center"
                      Style="{StaticResource PrimaryButton}"
                      Content="开启无线接收"
                      Click="WirelessButton_Click" />
            </Grid>
          </Border>
          </Expander>
          <TreeView x:Name="PhotoTree"
                    Grid.Row="3"
                    Margin="0,20,0,12"
                    Padding="8"
                    AllowDrop="True"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource RuleBrush}"
                    BorderThickness="1"
                    DragLeave="PhotoTree_DragLeave"
                    DragOver="PhotoTree_DragOver"
                    Drop="PhotoTree_Drop"
                    MouseDoubleClick="PhotoTree_MouseDoubleClick"
                    PreviewMouseLeftButtonDown="PhotoTree_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="PhotoTree_PreviewMouseLeftButtonUp"
                    PreviewMouseMove="PhotoTree_PreviewMouseMove"
                    SelectedItemChanged="PhotoTree_SelectedItemChanged">
            <TreeView.ItemContainerStyle>
              <Style TargetType="{x:Type TreeViewItem}">
                <Setter Property="IsExpanded"
                        Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="Padding" Value="4" />
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <Grid Margin="4,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid Width="56"
                        Height="42"
                        VerticalAlignment="Top">
                    <Image x:Name="NodeThumbnail"
                           Source="{Binding Thumbnail}"
                           Stretch="UniformToFill" />
                    <TextBlock x:Name="NodeIcon"
                               Visibility="Collapsed"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="15"
                               Text="{Binding Icon}" />
                  </Grid>
                  <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding Name}" />
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource MetaText}"
                               Text="{Binding Detail}" />
                  </StackPanel>
                </Grid>
                <HierarchicalDataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Thumbnail}"
                               Value="{x:Null}">
                    <Setter TargetName="NodeThumbnail"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="NodeIcon"
                            Property="Visibility"
                            Value="Visible" />
                  </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <StackPanel Grid.Row="4"
                      HorizontalAlignment="Right"
                      Orientation="Horizontal">
            <TextBlock Margin="0,0,18,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       Text="单击节点行展开 · 双击预览 · 拖动文件到分支" />
            <Button x:Name="DeleteBranchButton"
                    Width="118"
                    Margin="0,0,8,0"
                    Style="{StaticResource DangerButton}"
                    Content="删除分支"
                    IsEnabled="False"
                    Click="DeleteLibraryBranch_Click" />
            <Button x:Name="SharePhotoButton"
                    Width="150"
                    Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButton}"
                    Content="分享到社交平台"
                    IsEnabled="False"
                    Click="SharePhotoButton_Click" />
            <Button x:Name="DeletePhotoButton"
                    Width="118"
                    Style="{StaticResource DangerButton}"
                    Content="删除所选"
                    IsEnabled="False"
                    Click="DeletePhotoButton_Click" />
          </StackPanel>
        </Grid>

        <Grid x:Name="EditorPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border x:Name="EditorHeader" Padding="18"
                  Background="{StaticResource AccentSoftBrush}"
                  BorderBrush="{StaticResource AccentBrush}"
                  BorderThickness="1"
                  CornerRadius="14">
            <StackPanel>
              <TextBlock x:Name="EditorHeaderTitle"
                         Foreground="{StaticResource AccentBrush}"
                         FontFamily="{StaticResource DisplayFont}"
                         FontSize="24"
                         FontWeight="Bold"
                         Text="专业显影" />
              <TextBlock x:Name="EditorHeaderSubtitle"
                         Margin="0,4,0,0"
                         Foreground="{StaticResource MutedBrush}"
                         Text="分组调整光线、色彩、细节、效果与几何；始终保留原文件。" />
            </StackPanel>
          </Border>
          <Grid x:Name="EditorProGrid" Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Border Margin="0,0,18,0"
                    Padding="14"
                    Background="{StaticResource GraphiteBrush}"
                    BorderBrush="{StaticResource GraphiteRuleBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
              <Grid>
                <Image x:Name="EditorPreviewImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="EditorPreviewEmpty"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource GraphiteMutedBrush}"
                           FontSize="16"
                           Text="选择一张照片开始编辑" />
              </Grid>
            </Border>
            <Border Grid.Column="1"
                    Padding="18"
                    Style="{StaticResource PanelCard}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="编辑照片" />
                <ComboBox x:Name="EditorPhotoBox"
                          Grid.Row="1"
                          Margin="0,8,0,10"
                          SelectionChanged="EditorPhotoBox_SelectionChanged" />
                <DockPanel Grid.Row="2" Margin="0,0,0,10">
                  <TextBlock VerticalAlignment="Center"
                             FontWeight="SemiBold"
                             Text="预设" />
                  <ComboBox x:Name="EditorPresetBox"
                            Width="190"
                            Margin="10,0,0,0"
                            SelectionChanged="EditorPresetBox_SelectionChanged">
                    <ComboBoxItem Tag="original" Content="原始" />
                    <ComboBoxItem Tag="natural" Content="自然增强" />
                    <ComboBoxItem Tag="portrait" Content="人像柔和" />
                    <ComboBoxItem Tag="landscape" Content="风光通透" />
                    <ComboBoxItem Tag="monochrome" Content="高反差黑白" />
                  </ComboBox>
                </DockPanel>
                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="EditorAdjustmentHost" />
                </ScrollViewer>
                <TextBlock x:Name="EditorStatusText"
                           Grid.Row="4"
                           Margin="0,12,0,10"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="调整不会覆盖原文件"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Row="5"
                            Margin="0,0,0,8"
                            Orientation="Horizontal">
                  <Button x:Name="CompareEditorPhotoButton"
                          Width="132"
                          Style="{StaticResource ButtonBase}"
                          Content="查看原图"
                          Click="CompareEditorPhoto_Click" />
                  <Button Width="132"
                          Margin="8,0,0,0"
                          Style="{StaticResource ButtonBase}"
                          Content="全部重置"
                          Click="ResetEditor_Click" />
                </StackPanel>
                <Button x:Name="SaveEditedPhotoButton"
                        Grid.Row="6"
                        Height="46"
                        Style="{StaticResource PrimaryButton}"
                        Content="保存高质量副本"
                        IsEnabled="False"
                        Click="SaveEditedPhoto_Click" />
              </Grid>
            </Border>
          </Grid>

          <Grid x:Name="EditorAiGrid" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <Border Margin="0,0,18,0"
                    Padding="14"
                    Background="{StaticResource GraphiteBrush}"
                    BorderBrush="{StaticResource GraphiteRuleBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
              <Grid>
                <Image x:Name="AiPreviewImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="AiPreviewEmpty"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource GraphiteMutedBrush}"
                           FontSize="14"
                           Text="AI 生成结果将在这里显示" />
                <StackPanel HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                  <Border Background="#99000000"
                          CornerRadius="16"
                          Padding="10,6">
                    <TextBlock x:Name="AiPreviewBadge"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="AI 生成"
                               Visibility="Collapsed" />
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Column="1" Padding="16" Style="{StaticResource PanelCard}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="AI 模式" />
                <WrapPanel Margin="0,8,0,10">
                  <Button x:Name="AiEditModeBtn"
                          Width="140"
                          Height="40"
                          Content="AI 修图"
                          Click="AiEditMode_Click" />
                  <Button x:Name="AiGenModeBtn"
                          Width="140"
                          Height="40"
                          Margin="8,0,0,0"
                          Content="AI 生图"
                          Click="AiGenMode_Click" />
                </WrapPanel>
                <TextBlock FontWeight="SemiBold" Text="快捷预设" Margin="0,10,0,0" />
                <WrapPanel x:Name="AiPresetPanel" Margin="0,6,0,10" />
                <TextBlock FontWeight="SemiBold" Text="提示词" />
                <TextBox x:Name="AiPromptBox"
                         Margin="0,8,0,0"
                         Height="80"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
                <Button x:Name="AiGenerateBtn"
                        Margin="0,14,0,8"
                        Height="44"
                        Style="{StaticResource PrimaryButton}"
                        Content="生成"
                        Click="AiGenerate_Click" />
                <TextBlock x:Name="AiStatusText"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="请输入提示词"
                           TextWrapping="Wrap" />
                <Button x:Name="AiSaveBtn"
                        Margin="0,14,0,0"
                        Height="44"
                        Style="{StaticResource PrimaryButton}"
                        Content="保存到文件库"
                        Visibility="Collapsed"
                        Click="AiSave_Click" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <Grid x:Name="SettingsPanel" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="680" HorizontalAlignment="Left">
              <TextBlock Style="{StaticResource DisplayText}" Text="设置" />
              <TextBlock Margin="0,12,0,24"
                         Foreground="{StaticResource MutedBrush}"
                         Text="更新、诊断与应用支持。" />
              <Border Margin="0,0,0,20" Style="{StaticResource PanelCard}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="语言" />
                    <TextBlock Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Text="语言更改会立即应用，并在下次启动时保留。" />
                  </StackPanel>
                  <ComboBox x:Name="LanguageBox"
                            Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            SelectionChanged="LanguageBox_SelectionChanged">
                    <ComboBoxItem Tag="zh-Hans" Content="简体中文" />
                    <ComboBoxItem Tag="en" Content="English" />
                    <ComboBoxItem Tag="ja" Content="日本語" />
                  </ComboBox>
                </Grid>
              </Border>
              <Border Style="{StaticResource PanelCard}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="软件更新" />
                    <TextBlock x:Name="CurrentVersionText"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="UpdateStatusText"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               Text="尚未检查更新" />
                  </StackPanel>
                  <WrapPanel Grid.Column="1"
                             Margin="18,0,0,0"
                             VerticalAlignment="Center">
                    <Button x:Name="CheckUpdateButton"
                            Width="112"
                            Margin="0,0,8,0"
                            Style="{StaticResource ButtonBase}"
                            Content="检查更新"
                            Click="CheckUpdateButton_Click" />
                    <Button x:Name="OpenUpdateButton"
                            Width="132"
                            Style="{StaticResource PrimaryButton}"
                            Content="获取更新"
                            Visibility="Collapsed"
                            Click="OpenUpdateButton_Click" />
                  </WrapPanel>
                  <Grid Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <PasswordBox x:Name="MirrorChyanCdkBox"
                                   Height="38"
                                   Padding="10,7"
                                   ToolTip="Mirror酱 CDK（可选）" />
                      <TextBlock Margin="0,6,0,0"
                                 Foreground="{StaticResource MutedBrush}"
                                 Text="CDK 使用 Windows DPAPI 加密保存，不会写入诊断日志。" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="104"
                            Height="38"
                            Margin="10,0,0,0"
                            Style="{StaticResource ButtonBase}"
                            Content="保存 CDK"
                            Click="SaveMirrorChyanCdkButton_Click" />
                    <Button Grid.Column="2"
                            Width="124"
                            Height="38"
                            Margin="8,0,0,0"
                            Style="{StaticResource ButtonBase}"
                            Content="打开 Mirror酱"
                            Click="OpenMirrorChyanButton_Click" />
                  </Grid>
                </Grid>
              </Border>
              <Border Margin="0,20,0,0" Style="{StaticResource PanelCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitle}" Text="AI 功能激活" />
                  <TextBlock Margin="0,4,0,12"
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap"
                             Text="AI 修图与生图需购买激活码解锁。每个激活码 100 次，绑定设备，服务器端计数。" />
                  <TextBox x:Name="AiActivationCodeBox"
                           Height="38"
                           Padding="10,7"
                           ToolTip="激活码" />
                  <TextBox x:Name="AiServerUrlBox"
                           Margin="0,8,0,0"
                           Height="38"
                           Padding="10,7"
                           ToolTip="服务器地址" />
                  <WrapPanel Margin="0,10,0,0">
                    <Button Width="132"
                            Margin="0,0,8,0"
                            Style="{StaticResource ButtonBase}"
                            Content="购买激活码"
                            Click="AiBuy_Click" />
                    <Button Width="120"
                            Style="{StaticResource PrimaryButton}"
                            Content="激活"
                            Click="AiActivate_Click" />
                  </WrapPanel>
                  <TextBlock x:Name="AiActivationStatusText"
                             Margin="0,8,0,0"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="11"
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Margin="0,20,0,0" Style="{StaticResource PanelCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitle}" Text="诊断日志" />
                  <TextBlock x:Name="DiagnosticLogPathText"
                             Margin="0,0,0,16"
                             FontFamily="{StaticResource MonoFont}"
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap" />
                  <WrapPanel>
                    <Button Width="112"
                            Margin="0,0,8,0"
                            Style="{StaticResource ButtonBase}"
                            Content="查询日志"
                            Click="ViewLogs_Click" />
                    <Button Width="132"
                            Margin="0,0,8,0"
                            Style="{StaticResource ButtonBase}"
                            Content="打开日志目录"
                            Click="OpenLogFolder_Click" />
                    <Button Width="168"
                            Style="{StaticResource PrimaryButton}"
                            Content="上传脱敏日志"
                            Click="ReportIssue_Click" />
                  </WrapPanel>
                  <TextBlock Margin="0,12,0,0"
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap"
                             Text="将打开含最近脱敏日志的预填页面；在 GitHub 确认后才会提交。" />
                  <Border Margin="0,14,0,0"
                          Padding="14"
                          Background="{StaticResource AccentSoftBrush}"
                          BorderBrush="#B6CFF5"
                          BorderThickness="1"
                          CornerRadius="12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,16,0">
                        <TextBlock FontSize="15"
                                   FontWeight="Bold"
                                   Text="快速问题反馈" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="公开问题可继续在 GitHub 免费提交；在爱发电赞助后，可获取快速问题反馈渠道。" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              MinWidth="124"
                              Style="{StaticResource ButtonBase}"
                              Content="打开爱发电"
                              Click="OpenAfdianButton_Click" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <Border Margin="0,20,0,0" Style="{StaticResource PanelCard}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="喜欢 帧澈 ZENCHE？" />
                    <TextBlock Foreground="{StaticResource MutedBrush}"
                               Text="请作者喝杯奶茶，支持维护和新机型适配。" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Width="160"
                          Margin="18,0,0,0"
                          Style="{StaticResource PrimaryButton}"
                          Content="请作者喝奶茶"
                          Click="DonationButton_Click" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <Border x:Name="ParameterPanelShell"
              Grid.Column="2"
              Background="{StaticResource Paper2Brush}"
              BorderBrush="{StaticResource RuleBrush}"
              BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20">
            <TextBlock x:Name="ParameterPanelTitle"
                       Style="{StaticResource SectionTitle}"
                       Text="照片曝光与参数" />
            <TextBlock Text="拍摄模式" />
            <ComboBox x:Name="ExposureModeBox"
                      SelectionChanged="ExposureModeBox_SelectionChanged">
              <ComboBoxItem Tag="program" Content="P · 程序自动" />
              <ComboBoxItem Tag="shutterPriority" Content="S · 快门优先" />
              <ComboBoxItem Tag="aperturePriority" Content="A · 光圈优先" />
              <ComboBoxItem Tag="manual" Content="M · 手动" IsSelected="True" />
              <ComboBoxItem Tag="bulb" Content="M · B门" />
            </ComboBox>

            <TextBlock x:Name="VideoFrameRateLabel"
                       Text="快门角度换算帧率"
                       Visibility="Collapsed" />
            <ComboBox x:Name="VideoFrameRateBox"
                      Visibility="Collapsed"
                      SelectionChanged="VideoFrameRateBox_SelectionChanged">
              <ComboBoxItem Tag="24" Content="24 fps" />
              <ComboBoxItem Tag="25" Content="25 fps" />
              <ComboBoxItem Tag="30" Content="30 fps" IsSelected="True" />
              <ComboBoxItem Tag="50" Content="50 fps" />
              <ComboBoxItem Tag="60" Content="60 fps" />
            </ComboBox>

            <TextBlock x:Name="ShutterLabel" Text="快门速度" />
            <ComboBox x:Name="ShutterBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="0.000125" Content="1/8000 s" />
              <ComboBoxItem Tag="0.001" Content="1/1000 s" />
              <ComboBoxItem Tag="0.004" Content="1/250 s" />
              <ComboBoxItem Tag="0.008" Content="1/125 s" IsSelected="True" />
              <ComboBoxItem Tag="0.016667" Content="1/60 s" />
              <ComboBoxItem Tag="1" Content="1 s" />
              <ComboBoxItem Tag="30" Content="30 s" />
            </ComboBox>

            <TextBlock Text="光圈" />
            <ComboBox x:Name="ApertureBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="1.4" Content="f/1.4" />
              <ComboBoxItem Tag="2.8" Content="f/2.8" />
              <ComboBoxItem Tag="4" Content="f/4" IsSelected="True" />
              <ComboBoxItem Tag="5.6" Content="f/5.6" />
              <ComboBoxItem Tag="8" Content="f/8" />
              <ComboBoxItem Tag="11" Content="f/11" />
              <ComboBoxItem Tag="16" Content="f/16" />
            </ComboBox>

            <TextBlock Text="ISO 感光度" />
            <ComboBox x:Name="IsoBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="64" Content="ISO 64" />
              <ComboBoxItem Tag="100" Content="ISO 100" />
              <ComboBoxItem Tag="200" Content="ISO 200" />
              <ComboBoxItem Tag="400" Content="ISO 400" IsSelected="True" />
              <ComboBoxItem Tag="800" Content="ISO 800" />
              <ComboBoxItem Tag="1600" Content="ISO 1600" />
              <ComboBoxItem Tag="3200" Content="ISO 3200" />
              <ComboBoxItem Tag="6400" Content="ISO 6400" />
              <ComboBoxItem Tag="12800" Content="ISO 12800" />
              <ComboBoxItem Tag="25600" Content="ISO 25600" />
              <ComboBoxItem Tag="51200" Content="ISO 51200" />
              <ComboBoxItem Tag="64000" Content="ISO 64000" />
              <ComboBoxItem Tag="102400" Content="ISO 102400" />
            </ComboBox>

            <TextBlock Text="曝光补偿" />
            <ComboBox x:Name="ExposureCompensationBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="-2" Content="-2 EV" />
              <ComboBoxItem Tag="-1" Content="-1 EV" />
              <ComboBoxItem Tag="0" Content="0 EV" IsSelected="True" />
              <ComboBoxItem Tag="1" Content="+1 EV" />
              <ComboBoxItem Tag="2" Content="+2 EV" />
            </ComboBox>

            <TextBlock Text="对焦模式" />
            <ComboBox x:Name="FocusModeBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="single-shot" Content="AF-S · 单次自动对焦" IsSelected="True" />
              <ComboBoxItem Tag="continuous" Content="AF-C · 连续自动对焦" />
              <ComboBoxItem Tag="manual" Content="MF · 手动对焦" />
            </ComboBox>

            <TextBlock Text="白平衡" />
            <ComboBox x:Name="WhiteBalanceBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="continuous" Content="自动" IsSelected="True" />
              <ComboBoxItem Tag="manual" Content="预设手动" />
            </ComboBox>

            <TextBlock Text="优化校准" />
            <ComboBox x:Name="PictureControlBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="auto" Content="自动" />
              <ComboBoxItem Tag="standard" Content="标准" IsSelected="True" />
              <ComboBoxItem Tag="neutral" Content="自然" />
              <ComboBoxItem Tag="vivid" Content="鲜艳" />
              <ComboBoxItem Tag="monochrome" Content="单色" />
              <ComboBoxItem Tag="portrait" Content="人像" />
              <ComboBoxItem Tag="landscape" Content="风景" />
              <ComboBoxItem Tag="flat" Content="平面" />
            </ComboBox>

            <Expander x:Name="ProfessionalMonitorPanel"
                      Margin="0,16,0,0"
                      Header="专业监看"
                      Visibility="Collapsed"
                      IsExpanded="True">
              <StackPanel Margin="0,8,0,0">
                <CheckBox x:Name="FocusPeakingCheck"
                          Content="峰值对焦"
                          Click="FocusPeakingCheck_Click" />
                <CheckBox x:Name="FalseColorCheck"
                          Margin="0,6,0,0"
                          Content="假色曝光"
                          Click="FalseColorCheck_Click" />
                <Border Margin="0,10,0,0"
                        Padding="10"
                        Background="{StaticResource Paper2Brush}"
                        CornerRadius="6">
                  <StackPanel>
                    <TextBlock x:Name="RedHistogramText"
                               Foreground="#D22D34"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               Text="R —" />
                    <TextBlock x:Name="GreenHistogramText"
                               Foreground="#199152"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               Text="G —" />
                    <TextBlock x:Name="BlueHistogramText"
                               Foreground="{StaticResource AccentBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               Text="B —" />
                    <TextBlock x:Name="WaveformText"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               Text="Y —" />
                    <TextBlock x:Name="VectorscopeText"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               Text="H —" />
                    <TextBlock x:Name="PeakingCoverageText"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               Text="峰值覆盖 0%" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="{StaticResource GraphiteBrush}"
            BorderBrush="{StaticResource GraphiteRuleBrush}"
            BorderThickness="0,1,0,0">
      <Grid Margin="16,0">
        <TextBlock x:Name="OperationStatusText"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource GraphiteInkBrush}"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="11"
                   Text="就绪" />
        <TextBlock x:Name="PhotoCountText"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource GraphiteMutedBrush}"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="11"
                   Text="0 张照片" />
      </Grid>
    </Border>
  </Grid>
</Window>
