                      <Button Grid.Column="1"
                              MinWidth="124"
                              Style="{StaticResource ButtonBase}"
                              Content="打开爱发电"
                              Click="OpenAfdianButton_Click" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <Border Margin="0,20,0,0" Style="{StaticResource PanelCard}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="喜欢 帧澈 ZENCHE？" />
                    <TextBlock Foreground="{StaticResource MutedBrush}"
                               Text="请作者喝杯奶茶，支持维护和新机型适配。" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Width="160"
                          Margin="18,0,0,0"
                          Style="{StaticResource PrimaryButton}"
                          Content="请作者喝奶茶"
                          Click="DonationButton_Click" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <Border x:Name="ParameterPanelShell"
              Grid.Column="2"
              Background="{StaticResource Paper2Brush}"
              BorderBrush="{StaticResource RuleBrush}"
              BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20">
            <TextBlock x:Name="ParameterPanelTitle"
                       Style="{StaticResource SectionTitle}"
                       Text="拍摄控制" />
            <TextBlock Margin="0,8,0,4"
                       FontWeight="Bold"
                       Foreground="{StaticResource MutedBrush}"
                       Text="曝光" />
            <TextBlock x:Name="ExposureModeLabel" Text="拍摄模式" />
            <ComboBox x:Name="ExposureModeBox"
                      SelectionChanged="ExposureModeBox_SelectionChanged">
              <ComboBoxItem Tag="program" Content="P · 程序自动" />
              <ComboBoxItem Tag="shutterPriority" Content="S · 快门优先" />
              <ComboBoxItem Tag="aperturePriority" Content="A · 光圈优先" />
              <ComboBoxItem Tag="manual" Content="M · 手动" IsSelected="True" />
              <ComboBoxItem Tag="bulb" Content="M · B门" />
            </ComboBox>

            <TextBlock x:Name="VideoFrameRateLabel"
                       Text="快门角度换算帧率"
                       Visibility="Collapsed" />
            <ComboBox x:Name="VideoFrameRateBox"
                      Visibility="Collapsed"
                      SelectionChanged="VideoFrameRateBox_SelectionChanged">
              <ComboBoxItem Tag="24" Content="24 fps" />
              <ComboBoxItem Tag="25" Content="25 fps" />
              <ComboBoxItem Tag="30" Content="30 fps" IsSelected="True" />
              <ComboBoxItem Tag="50" Content="50 fps" />
              <ComboBoxItem Tag="60" Content="60 fps" />
            </ComboBox>

            <TextBlock x:Name="ShutterLabel" Text="快门速度" />
            <TextBlock x:Name="VideoShutterModeLabel" Text="视频快门表示" Visibility="Collapsed" />
            <ComboBox x:Name="VideoShutterModeBox"
                      Visibility="Collapsed"
                      SelectionChanged="VideoShutterModeBox_SelectionChanged">
              <ComboBoxItem Tag="speed" Content="快门速度" />
              <ComboBoxItem Tag="angle" Content="快门角度" IsSelected="True" />
            </ComboBox>
            <ComboBox x:Name="ShutterBox"
                      SelectionChanged="ParameterBox_SelectionChanged">
              <ComboBoxItem Tag="0.000125" Content="1/8000 s" />
              <ComboBoxItem Tag="0.001" Content="1/1000 s" />
              <ComboBoxItem Tag="0.004" Content="1/250 s" />
              <ComboBoxItem Tag="0.008" Content="1/125 s" IsSelected="True" />
              <ComboBoxItem Tag="0.016667" Content="1/60 s" />
              <ComboBoxItem Tag="1" Content="1 s" />
              <ComboBoxItem Tag="30" Content="30 s" />
            </ComboBox>

            <TextBlock x:Name="VideoCodecLabel"
                       Text="视频录制规格"
                       Visibility="Collapsed" />
            <ComboBox x:Name="VideoCodecBox"
                      Visibility="Collapsed"
                      SelectionChanged="VideoCodecBox_SelectionChanged" />
            <TextBlock x:Name="VideoLogLabel"
                       Margin="0,8,0,0"
                       Text="Log / Picture Profile"
                       Visibility="Collapsed" />
            <ComboBox x:Name="VideoLogBox"
                      Margin="0,0,0,10"
                      Visibility="Collapsed"
                      SelectionChanged="VideoLogBox_SelectionChanged" />
