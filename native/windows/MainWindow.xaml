<Window x:Class="NikonLink.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NikonLink.Windows"
        Title="帧澈 ZENCHE"
        Icon="Assets/icon-512.png"
        Width="1280"
        Height="820"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <!-- fig2 editor tool strip icons: 16x16 linear monochrome line art. -->
    <Geometry x:Key="EditorIconColorWheel">
      M8,1.5 A6.5,6.5 0 1,0 8,14.5 A6.5,6.5 0 1,0 8,1.5
      M8,8 L14,8
      M8,8 L5,2.8
      M8,8 L5,13.2
      M8,7.3 A0.7,0.7 0 1,0 8,8.7 A0.7,0.7 0 1,0 8,7.3
    </Geometry>
    <Geometry x:Key="EditorIconCurve">
      M2,13 C4.5,11.5 5.5,5.5 9,5 C11.5,4.6 12.5,6.5 14,3.5
      M8.2,4.6 L9.8,4.6 L9.8,6.2 L8.2,6.2 Z
      M12.6,6.6 L14.2,6.6 L14.2,8.2 L12.6,8.2 Z
    </Geometry>
    <Geometry x:Key="EditorIconMask">
      M3,2 H13 A1,1 0 0,1 14,3 V13 A1,1 0 0,1 13,14 H3 A1,1 0 0,1 2,13 V3 A1,1 0 0,1 3,2 Z
      M8,8 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0
    </Geometry>
    <Geometry x:Key="EditorIconGeometry">
      M3,9.5 L7,4 L11,9.5 Z
      M12,5.2 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0
      M3,11.5 H13 V14 H3 Z
    </Geometry>
    <Geometry x:Key="EditorIconAi">
      M8,2 L9.3,6.7 L14,8 L9.3,9.3 L8,14 L6.7,9.3 L2,8 L6.7,6.7 Z
    </Geometry>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="76" />
      <RowDefinition Height="*" />
      <RowDefinition Height="34" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource AppBarBrush}"
            BorderBrush="{DynamicResource AppBarRuleBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
          <Border Width="44"
                  Height="44"
                  Background="{DynamicResource UiBlueBrush}"
                  CornerRadius="13">
            <!-- 品牌标 Z 22/品牌名 19：AppBar 品牌区豁免（设计品牌资产，不受 TypeScale 约束） -->
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource DisplayFont}"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentInkBrush}"
                       Text="Z" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock FontFamily="{DynamicResource DisplayFont}"
                       FontSize="19"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppBarInkBrush}"
                       Text="帧澈 ZENCHE" />
            <TextBlock Margin="0,3,0,0"
                       Style="{DynamicResource MetaText}"
                       Foreground="{DynamicResource AppBarMutedBrush}"
                       Text="Capture · Connect · Flow" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1"
                Margin="16,0"
                Padding="12,8"
                VerticalAlignment="Center"
                Background="{DynamicResource UiSecondaryBrush}"
                BorderBrush="{DynamicResource UiSecondaryBrush}"
                BorderThickness="1"
                CornerRadius="18">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="ConnectionDot"
                     Width="8"
                     Height="8"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource UiLabelBrush}" />
            <TextBlock x:Name="CameraStatusText"
                       Style="{DynamicResource MetaText}"
                       Foreground="{DynamicResource AppBarInkBrush}"
                       MaxWidth="260"
                       Text="未连接 · WINDOWS USB/PTP"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
          </StackPanel>
        </Border>
        <Button x:Name="ConnectButton"
                Grid.Column="2"
                Width="142"
                Style="{DynamicResource PrimaryButton}"
                Effect="{x:Null}"
                Content="连接管理"
                Click="ConnectButton_Click" />
        <!-- 图标尺寸 20，豁免族（⚙ 胶囊钮符号） -->
        <Button x:Name="SettingsButton"
                Grid.Column="3"
                Width="48"
                Margin="10,0,0,0"
                FontFamily="Segoe UI Symbol"
                FontSize="20"
                Style="{DynamicResource UiCapsuleButton}"
                Content="⚙"
                ToolTip="设置"
                Click="SettingsButton_Click" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="176" />
        <ColumnDefinition Width="*" MinWidth="380" />
        <ColumnDefinition x:Name="ParameterColumn" Width="300" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{DynamicResource SidebarBrush}"
              BorderBrush="{DynamicResource RuleBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel Margin="18">
          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Style="{DynamicResource MetaText}" Text="ZENCHE 1.5.3" />
            <TextBlock Margin="0,4,0,0"
                       Style="{DynamicResource SidebarHint}"
                       Text="照片保存在“图片\帧澈 ZENCHE”" />
          </StackPanel>
          <StackPanel>
            <TextBlock Margin="12,0,0,16"
                       Style="{DynamicResource MetaText}"
                       Text="工作区" />
            <Button x:Name="CaptureNav"
                    Style="{DynamicResource NavButton}"
                    Tag="capture"
                    Content="拍照"
                    Click="Navigate_Click" />
            <Button x:Name="MonitorNav"
                    Style="{DynamicResource NavButton}"
                    Tag="monitor"
                    Content="视频"
                    Click="Navigate_Click" />
            <Button x:Name="EditorNav"
                    Style="{DynamicResource NavButton}"
                    Tag="editor"
                    Content="编辑"
                    Click="Navigate_Click" />
            <Button x:Name="DevicesNav"
                    Style="{DynamicResource NavButton}"
                    Tag="devices"
                    Content="我的设备"
                    Click="Navigate_Click" />
            <Button x:Name="LibraryNav"
                    Style="{DynamicResource NavButton}"
                    Tag="library"
                    Content="分支"
                    Click="Navigate_Click" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="24">
        <Grid x:Name="MonitorDashboard" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource MonitorWellBrush}" Padding="20,16" BorderBrush="{DynamicResource MonitorWellSecondaryBrush}" BorderThickness="1,1,1,0">
            <Grid>
              <TextBlock x:Name="MonitorTimecodeText" Text="00:00:00:00" Style="{DynamicResource MonitorTimecode}" />
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource ConnectedDotBrush}" />
                <TextBlock x:Name="MonitorLiveStatusText" Text="NO SOURCE" Style="{DynamicResource MonitorLiveStatus}" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="{DynamicResource MonitorWellBrush}" BorderBrush="{DynamicResource MonitorWellSecondaryBrush}" BorderThickness="1,0,1,0" ClipToBounds="True">
            <Grid>
              <Image x:Name="MonitorPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" MouseLeftButtonUp="MonitorPreviewImage_MouseLeftButtonUp" />
              <!-- 图标尺寸 38，豁免族（对焦框符号，不受样式库约束） -->
              <TextBlock x:Name="MonitorFocusReticle" Text="＋" Visibility="Collapsed" Foreground="{DynamicResource PeakingBrush}" FontSize="38" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" />
              <StackPanel x:Name="MonitorPreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" Text="等待实时取景画面" Style="{DynamicResource MonitorEmptyState}" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Text="连接相机后开启实时取景" Foreground="{DynamicResource MonitorWellLabelBrush}" />
              </StackPanel>
              <TextBlock x:Name="MonitorCameraOverlay" Margin="16" VerticalAlignment="Top" Text="未连接 · USB/PTP" Style="{DynamicResource MonitorOverlayMeta}" />
            </Grid>
          </Border>
          <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,12,0" Padding="3" Background="{DynamicResource ScopeBlackBrush}">
              <local:WaveformScope x:Name="MonitorRgbScope"
                                   Mode="RgbParade"
                                   Height="98"
                                   AutomationProperties.Name="RGB 波形" />
            </Border>
            <Button x:Name="MonitorRecordButton" Grid.Column="1" Width="108" Height="108" Style="{DynamicResource ButtonBase}" Click="ShutterButton_Click" ToolTip="开始或停止录制">
              <Grid>
                <Ellipse Width="96" Height="96" Stroke="{DynamicResource MonitorWellTextBrush}" StrokeThickness="2" />
                <Ellipse Width="58" Height="58" Fill="{DynamicResource VideoBrush}" />
              </Grid>
            </Button>
            <Border Grid.Column="2" Margin="12,0,0,0" Padding="3" Background="{DynamicResource ScopeBlackBrush}">
              <local:WaveformScope Mode="Audio"
                                   Height="98"
                                   AutomationProperties.Name="音频波形，无音频源，静音基线" />
            </Border>
          </Grid>
          <UniformGrid Grid.Row="3" Columns="7" Margin="0,18,0,0">
            <StackPanel Margin="4"><TextBlock Text="帧率" Style="{DynamicResource MonitorWellLabel}" /><TextBlock x:Name="MonitorFrameRateText" Text="—" Style="{DynamicResource MonitorReadout}" /></StackPanel>
            <StackPanel Margin="4"><TextBlock Text="快门" Style="{DynamicResource MonitorWellLabel}" /><TextBlock x:Name="MonitorShutterText" Text="—" Style="{DynamicResource MonitorReadout}" /></StackPanel>
            <StackPanel Margin="4"><TextBlock Text="光圈" Style="{DynamicResource MonitorWellLabel}" /><TextBlock x:Name="MonitorApertureText" Text="—" Style="{DynamicResource MonitorReadout}" /></StackPanel>
            <StackPanel Margin="4"><TextBlock Text="ISO" Style="{DynamicResource MonitorWellLabel}" /><TextBlock x:Name="MonitorIsoText" Text="—" Style="{DynamicResource MonitorReadout}" /></StackPanel>
            <StackPanel Margin="4"><TextBlock Text="白平衡" Style="{DynamicResource MonitorWellLabel}" /><TextBlock x:Name="MonitorWhiteBalanceText" Text="—" Style="{DynamicResource MonitorReadout}" /></StackPanel>
            <StackPanel Margin="4"><TextBlock Text="编码" Style="{DynamicResource MonitorWellLabel}" /><TextBlock x:Name="MonitorCodecText" Text="—" Style="{DynamicResource MonitorReadout}" /></StackPanel>
            <StackPanel Margin="4"><TextBlock Text="色调" Style="{DynamicResource MonitorWellLabel}" /><TextBlock x:Name="MonitorToneText" Text="—" Style="{DynamicResource MonitorReadout}" /></StackPanel>
          </UniformGrid>
          <StackPanel Grid.Row="4" Margin="0,16,0,4">
            <Border MaxWidth="720"
                    HorizontalAlignment="Center"
                    Padding="12,10"
                    Background="{DynamicResource MonitorWellCardBrush}"
                    BorderBrush="{DynamicResource MonitorWellSecondaryBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" Background="{DynamicResource AccentBrush}" CornerRadius="12">
                  <TextBlock HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Style="{DynamicResource CaptureBadge}"
                             Text="NP3" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                  <TextBlock Style="{DynamicResource MonitorCloudTitle}" Text="尼康云创监看" />
                  <TextBlock Margin="0,2,0,0" Style="{DynamicResource MonitorWellLabel}" Text="107 款设备端 SDR 预设" />
                </StackPanel>
                <ComboBox x:Name="MonitorNikonCloudPresetBox"
                          Grid.Column="2"
                          Height="44"
                          Margin="0"
                          MaxDropDownHeight="360"
                          IsTextSearchEnabled="True"
                          StaysOpenOnEdit="False"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          TextSearch.TextPath="Content"
                          AutomationProperties.Name="选择尼康云创监看预设"
                          SelectionChanged="MonitorNikonCloudPresetBox_SelectionChanged" />
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           Style="{DynamicResource MonitorWellLabel}"
                           Text="照片与视频实时生效 · SDR 近似 · 不写入原片" />
              </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
              <Button x:Name="MonitorFocusButton" Style="{DynamicResource MonitorIconButton}" Tag="focus" Content="◎\n峰值" Click="MonitorFocusButton_Click" />
              <Button x:Name="MonitorLutButton" Style="{DynamicResource MonitorIconButton}" Tag="lut" Content="LUT\nLUT" Click="MonitorLutButton_Click" />
              <Button x:Name="MonitorFalseColorButton" Style="{DynamicResource MonitorIconButton}" Tag="false" Content="◉\n假色" Click="MonitorFalseColorButton_Click" />
              <Button x:Name="MonitorZebraButton" Style="{DynamicResource MonitorIconButton}" Tag="zebra" Content="±\n斑马" Click="MonitorZebraButton_Click" />
              <Button x:Name="MonitorAutoFocusButton" Style="{DynamicResource MonitorIconButton}" Tag="af" Content="◎A\nAF-ON" Click="MonitorAutoFocusButton_Click" />
              <Button x:Name="MonitorLiveViewButton" Style="{DynamicResource MonitorIconButton}" Content="▣\n取景" Click="LiveViewButton_Click" />
            </StackPanel>
          </StackPanel>
          <Border Grid.Row="5" Margin="0,24,0,0" Padding="16" HorizontalAlignment="Center" Background="{DynamicResource MonitorWellCardBrush}" CornerRadius="10">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{DynamicResource MonitorStorageIcon}" Text="▯" VerticalAlignment="Center" />
              <StackPanel Margin="12,0,0,0"><TextBlock x:Name="MonitorStorageFreeText" Text="—" Style="{DynamicResource MonitorReadout}" /><TextBlock x:Name="MonitorStorageDetailText" Text="本地缓存 · 存储状态暂不可用" Style="{DynamicResource MonitorWellLabel}" /></StackPanel>
            </StackPanel>
          </Border>
        </Grid>
        <Grid x:Name="CapturePanel">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!-- v1.5.5 fig1 control page: status row + status cards (desktop 4-col) -->
          <Border x:Name="ControlStatusRow"
                  Grid.Row="0"
                  Margin="0,0,0,10"
                  Padding="14,10"
                  Background="{DynamicResource UiCardBrush}"
                  CornerRadius="14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="ControlStatusDot"
                       Width="10"
                       Height="10"
                       VerticalAlignment="Center"
                       Fill="{DynamicResource UiLabelBrush}" />
              <TextBlock x:Name="ControlStatusText"
                         Grid.Column="1"
                         Margin="10,0,0,0"
                         VerticalAlignment="Center"
                         Style="{DynamicResource CaptureStatusHint}"
                         FontWeight="Bold"
                         Foreground="{DynamicResource UiCardInkBrush}"
                         Text="未连接" />
              <Border x:Name="ControlStatusRateCapsule"
                      Grid.Column="2"
                      Padding="14,6"
                      Background="{DynamicResource UiSecondaryBrush}"
                      CornerRadius="15">
                <TextBlock x:Name="ControlStatusRateText"
                           Style="{DynamicResource CaptureSubHint}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource UiCardInkBrush}"
                           Text="待连接" />
              </Border>
              <TextBlock x:Name="ControlStatusErrorText"
                         Grid.Row="1"
                         Grid.ColumnSpan="3"
                         Margin="0,6,0,0"
                         Style="{DynamicResource CaptureSubHint}"
                         Foreground="{DynamicResource VideoBrush}"
                         TextTrimming="CharacterEllipsis"
                         TextWrapping="NoWrap"
                         Visibility="Collapsed" />
            </Grid>
          </Border>
          <UniformGrid x:Name="ControlStatusGrid" Grid.Row="1" Columns="4" Margin="0,0,0,10">
            <Border Margin="0,0,6,0" Padding="14,10" Background="{DynamicResource UiCardBrush}" CornerRadius="14">
              <StackPanel>
                <TextBlock Style="{DynamicResource CaptureFieldLabel}" Text="机身" />
                <TextBlock x:Name="CaptureDeviceNameText" Margin="0,4,0,0" Style="{DynamicResource CaptureFieldValue}" />
              </StackPanel>
            </Border>
            <Border Margin="3,0" Padding="14,10" Background="{DynamicResource UiCardBrush}" CornerRadius="14">
              <StackPanel>
                <TextBlock Style="{DynamicResource CaptureFieldLabel}" Text="传输" />
                <TextBlock x:Name="CaptureLinkText" Margin="0,4,0,0" Style="{DynamicResource CaptureFieldValue}" />
              </StackPanel>
            </Border>
            <Border Margin="3,0" Padding="14,10" Background="{DynamicResource UiCardBrush}" CornerRadius="14">
              <StackPanel>
                <TextBlock Style="{DynamicResource CaptureFieldLabel}" Text="格式" />
                <TextBlock x:Name="CaptureOutputText" Margin="0,4,0,0" Style="{DynamicResource CaptureFieldValue}" />
              </StackPanel>
            </Border>
            <Border Margin="6,0,0,0" Padding="14,10" Background="{DynamicResource UiCardBrush}" CornerRadius="14">
              <StackPanel>
                <TextBlock Style="{DynamicResource CaptureFieldLabel}" Text="文件库" />
                <TextBlock x:Name="CaptureLibraryText" Margin="0,4,0,0" Style="{DynamicResource CaptureFieldValue}" />
              </StackPanel>
            </Border>
          </UniformGrid>
          <Expander Grid.Row="5"
                    Margin="0,14,0,0"
                    Header="拍前会话与交付"
                    IsExpanded="False">
            <Border Padding="14" Style="{DynamicResource PanelCard}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                  <TextBlock Text="项目名称" />
                  <TextBox x:Name="SessionNameText" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                  <TextBlock Text="命名模板" />
                  <TextBox x:Name="SessionNamingTemplateText" FontFamily="{DynamicResource MonoFont}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                  <TextBlock Text="默认评级" />
                  <ComboBox x:Name="SessionRatingBox" SelectedIndex="0">
                    <ComboBoxItem Content="0 星" Tag="0" />
                    <ComboBoxItem Content="1 星" Tag="1" />
                    <ComboBoxItem Content="2 星" Tag="2" />
                    <ComboBoxItem Content="3 星" Tag="3" />
                    <ComboBoxItem Content="4 星" Tag="4" />
                    <ComboBoxItem Content="5 星" Tag="5" />
                  </ComboBox>
                </StackPanel>
                <CheckBox x:Name="SessionDualBackupCheck"
                          Grid.Column="3"
                          Margin="0,20,0,0"
                          VerticalAlignment="Center"
                          Content="双目标备份"
                          IsChecked="True" />
                <StackPanel Grid.Row="1" Margin="0,10,10,0">
                  <TextBlock Text="创作者" />
                  <TextBox x:Name="SessionCreatorText" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,10,0">
                  <TextBlock Text="版权" />
                  <TextBox x:Name="SessionRightsText" />
                </StackPanel>
                <TextBlock x:Name="SessionStatusText"
                           Grid.Row="2"
                           Grid.ColumnSpan="3"
                           Margin="0,12,12,0"
                           VerticalAlignment="Center"
                           Style="{DynamicResource CaptureSessionHint}"
                           Text="尚未开始拍摄会话" />
                <Button x:Name="SessionActionButton"
                        Grid.Row="2"
                        Grid.Column="3"
                        Height="42"
                        Margin="0,10,0,0"
                        Style="{DynamicResource PrimaryButton}"
                        Content="开始会话"
                        Click="SessionActionButton_Click" />
              </Grid>
            </Border>
          </Expander>
          <Border Grid.Row="2"
                  Background="{DynamicResource GraphiteBrush}"
                  BorderBrush="{DynamicResource GraphiteRuleBrush}"
                  BorderThickness="1"
                  CornerRadius="18"
                  ClipToBounds="True">
            <Grid>
              <Image x:Name="PreviewImage"
                     Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel x:Name="PreviewEmpty"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{DynamicResource GraphiteInkBrush}"
                           Style="{DynamicResource CaptureEmptyTitle}"
                           Text="等待相机画面" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{DynamicResource GraphiteMutedBrush}"
                           Text="连接相机后开启实时取景" />
              </StackPanel>
              <Border HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="16"
                      Padding="8,4"
                      CornerRadius="5"
                      Background="{DynamicResource Graphite2Brush}">
                <TextBlock x:Name="LiveBadge"
                           Style="{DynamicResource MetaText}"
                           Foreground="{DynamicResource GraphiteMutedBrush}"
                           Text="LIVE VIEW OFF" />
              </Border>
              <Button HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Width="96"
                      Height="42"
                      Margin="16"
                      Style="{DynamicResource ButtonBase}"
                      Content="全屏"
                      Click="FullscreenPreviewButton_Click" />
            </Grid>
          </Border>
          <Border x:Name="ControlParameterGrid"
                  Grid.Row="3"
                  Margin="0,14,0,0"
                  Padding="14"
                  Background="{DynamicResource UiCardBrush}"
                  CornerRadius="14">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{DynamicResource CaptureCardTitle}" Text="参数" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="GridEditAllButton"
                          Width="68"
                          Height="32"
                          Margin="0,0,8,0"
                          Style="{DynamicResource ButtonBase}"
                          Content="全部"
                          Click="GridEditAllButton_Click" />
                  <Button x:Name="GridEditButton"
                          Width="68"
                          Height="32"
                          Style="{DynamicResource ButtonBase}"
                          Content="编辑"
                          Click="GridEditButton_Click" />
                </StackPanel>
              </Grid>
              <UniformGrid Columns="3" Margin="0,12,0,0">
                <Border x:Name="ParameterTileSource"
                        Margin="0,0,6,6"
                        Padding="12,10"
                        Background="{DynamicResource UiSecondaryBrush}"
                        CornerRadius="14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Style="{DynamicResource CaptureReadoutLabel}" Text="来源" />
                      <TextBlock x:Name="SourceReadoutText" Margin="0,4,0,0" Style="{DynamicResource CaptureReadoutValue}" />
                    </StackPanel>
                    <TextBlock x:Name="ParameterTileSourceHide"
                               Grid.Column="1"
                               Style="{DynamicResource CaptureReadoutUnit}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource UiLabelBrush}"
                               Text="×"
                               Cursor="Hand"
                               Visibility="Collapsed"
                               Tag="ParameterTileSource"
                               MouseLeftButtonUp="ParameterTileHide_Click" />
                  </Grid>
                </Border>
                <Border x:Name="ParameterTileMode"
                        Margin="3,0,3,6"
                        Padding="12,10"
                        Background="{DynamicResource UiSecondaryBrush}"
                        CornerRadius="14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
