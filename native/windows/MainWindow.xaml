                                 Foreground="{StaticResource MutedBrush}"
                                 Text="CDK 使用 Windows DPAPI 加密保存，不会写入诊断日志。" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="104"
                            Height="38"
                            Margin="10,0,0,0"
                            Style="{StaticResource ButtonBase}"
                            Content="保存 CDK"
                            Click="SaveMirrorChyanCdkButton_Click" />
                    <Button Grid.Column="2"
                            Width="124"
                            Height="38"
                            Margin="8,0,0,0"
                            Style="{StaticResource ButtonBase}"
                            Content="打开 Mirror酱"
                            Click="OpenMirrorChyanButton_Click" />
                  </Grid>
                </Grid>
              </Border>
              <Border Margin="0,20,0,0" Style="{StaticResource PanelCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitle}" Text="AI 功能激活" />
                  <TextBlock Margin="0,4,0,12"
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap"
                             Text="AI 修图与生图需购买激活码解锁。每个激活码 100 次，绑定设备，服务器端计数。" />
                  <Button Height="42"
                          Style="{StaticResource PrimaryButton}"
                          Content="前往官网兑换密钥"
                          Click="AiOfficialWebsite_Click" />
                  <TextBlock Margin="0,8,0,12"
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap"
                             Text="复制设备 ID 后，前往 zenche.top 使用兑换码兑换绑定当前设备的激活密钥。" />
                  <TextBlock Margin="0,0,0,8"
                             FontWeight="SemiBold"
                             Text="没有兑换码？在爱发电购买兑换码" />
                  <Button Width="300"
                          Height="416"
                          Margin="0,0,0,8"
                          HorizontalAlignment="Center"
                          Padding="4"
                          Style="{StaticResource ButtonBase}"
                          ToolTip="在爱发电购买兑换码"
                          Click="AiBuy_Click">
                    <Image Source="pack://application:,,,/Assets/wechat-donation.png"
                           Stretch="Uniform" />
                  </Button>
                  <Button Height="38"
                          Margin="0,0,0,6"
                          Style="{StaticResource ButtonBase}"
                          Content="在爱发电购买兑换码"
                          Click="AiBuy_Click" />
                  <TextBlock Margin="0,0,0,12"
                             FontSize="11"
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap"
                             Text="兑换码仅用于 AI 云服务次数，帧澈本体保持免费开源。" />
                  <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ButtonBase}"
                            Content="复制"
                            Click="AiCopyDeviceId_Click" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="我的设备 ID" />
                  </DockPanel>
                  <TextBlock x:Name="AiDeviceIdText"
                             Margin="0,0,0,8"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="11"
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap" />
                  <TextBlock Margin="0,0,0,12"
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap"
                             Text="每个激活密钥绑定当前设备，请复制上面的设备 ID 并前往官网兑换。" />
                  <TextBox x:Name="AiActivationCodeBox"
                           Height="38"
                           Padding="10,7"
                           ToolTip="激活码" />
                  <WrapPanel Margin="0,10,0,0">
                    <Button Width="132"
                            Margin="0,0,8,0"
                            Style="{StaticResource ButtonBase}"
                            Content="购买激活码"
                            Click="AiBuy_Click" />
                    <Button Width="120"
                            Style="{StaticResource PrimaryButton}"
                            Content="激活"
                            Click="AiActivate_Click" />
                  </WrapPanel>
                  <TextBlock x:Name="AiActivationStatusText"
                             Margin="0,8,0,0"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="11"
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Margin="0,20,0,0" Style="{StaticResource PanelCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitle}" Text="诊断日志" />
                  <TextBlock x:Name="DiagnosticLogPathText"
                             Margin="0,0,0,16"
                             FontFamily="{StaticResource MonoFont}"
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap" />
                  <WrapPanel>
                    <Button Width="112"
                            Margin="0,0,8,0"
                            Style="{StaticResource ButtonBase}"
                            Content="查询日志"
                            Click="ViewLogs_Click" />
                    <Button Width="132"
                            Margin="0,0,8,0"
                            Style="{StaticResource ButtonBase}"
                            Content="打开日志目录"
                            Click="OpenLogFolder_Click" />
                    <Button Width="168"
                            Style="{StaticResource PrimaryButton}"
                            Content="上传脱敏日志"
                            Click="ReportIssue_Click" />
                  </WrapPanel>
                  <TextBlock Margin="0,12,0,0"
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap"
                             Text="将打开含最近脱敏日志的预填页面；在 GitHub 确认后才会提交。" />
