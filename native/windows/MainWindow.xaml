                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="AiRatioBox"
                            Grid.Column="0"
                            SelectionChanged="AiRatioBox_SelectionChanged">
                    <ComboBoxItem Content="1:1" />
                    <ComboBoxItem Content="16:9" />
                    <ComboBoxItem Content="9:16" />
                    <ComboBoxItem Content="4:3" />
                    <ComboBoxItem Content="3:2" />
                  </ComboBox>
                  <ComboBox x:Name="AiResolutionBox"
                            Grid.Column="2"
                            SelectionChanged="AiResolutionBox_SelectionChanged">
                    <ComboBoxItem Content="1K" />
                    <ComboBoxItem Content="2K" />
                    <ComboBoxItem Content="4K" />
                  </ComboBox>
                </Grid>
                  </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="0,10,0,0"
                        BorderBrush="{StaticResource RuleBrush}"
                        BorderThickness="0,1,0,0">
                  <StackPanel>
                <Button x:Name="AiGenerateBtn"
                        Margin="0,0,0,8"
                        Height="44"
                        Style="{StaticResource PrimaryButton}"
                        Content="生成图像"
                        Click="AiGenerate_Click" />
                <TextBlock x:Name="AiStatusText"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="请输入提示词"
                           TextWrapping="Wrap" />
                <Button x:Name="AiSaveBtn"
                        Margin="0,14,0,0"
                        Height="44"
                        Style="{StaticResource PrimaryButton}"
                        Content="保存到文件库"
                        Visibility="Collapsed"
                        Click="AiSave_Click" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <Grid x:Name="SettingsPanel" Visibility="Collapsed">
